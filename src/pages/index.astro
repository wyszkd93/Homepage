---
import Base from '../layouts/Base.astro';
import PostRows from '../components/PostRows.astro';
import { PROFILE } from '../consts';
import { TOOLS } from '../data/tools';
import { getPosts } from '../utils/posts';
import { url } from '../utils/url';
import { Image } from 'astro:assets';
import mogu from '../assets/mogu.webp';

const recent = (await getPosts()).slice(0, 6);
---

<Base heading={PROFILE.name} tagline={PROFILE.tagline}>
  <ul class="hero-links" slot="hero">
    {PROFILE.links.map((l) => <li><a class="cta-btn" href={l.url}>{l.label}</a></li>)}
  </ul>
  <Image
    slot="aside"
    class="hero-art"
    src={mogu}
    widths={[320, 480, 720]}
    sizes="(max-width: 720px) 240px, 320px"
    alt="안경과 나비넥타이를 한 포메라니안 캐릭터 모구가 노트북으로 코딩하는 그림"
    loading="eager"
  />

  <section class="section">
    <h2 class="section-title">소개</h2>
    <div class="lead">
      {PROFILE.about.map((p) => <p>{p}</p>)}
    </div>
  </section>

  <section class="section grid-2">
    <div>
      <h2 class="section-title">관심 분야</h2>
      <ul class="chips">{PROFILE.interests.map((i) => <li class="chip">{i}</li>)}</ul>
    </div>
    <div>
      <h2 class="section-title">기술 스택</h2>
      <ul class="chips">{PROFILE.stack.map((s) => <li class="chip">{s}</li>)}</ul>
    </div>
  </section>

  {PROFILE.projects.length > 0 && (
    <section class="section">
      <h2 class="section-title">프로젝트</h2>
      <ul class="cards">
        {PROFILE.projects.map((p) => (
          <li class="card">
            <h3 class="card-title">{p.url ? <a href={p.url}>{p.name}</a> : p.name}</h3>
            <p class="card-desc">{p.description}</p>
          </li>
        ))}
      </ul>
    </section>
  )}

  <section class="section">
    <h2 class="section-title">유용한 기능</h2>
    <ul class="tool-cards">
      {TOOLS.map((t) => (
        <li>
          <a class="tool-card" href={url(`/tools/${t.slug}/`)} style={`--tool: ${t.color}`}>
            <span class="tool-card-top">
              <span class="tool-icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" set:html={t.icon} />
              </span>
              {t.badge && <span class={`tool-badge tool-badge-${t.badge.toLowerCase()}`}>{t.badge}</span>}
            </span>
            <span class="tool-title">{t.title}</span>
            <span class="tool-desc">{t.description}</span>
            <span class="tool-go">써 보기 →</span>
          </a>
        </li>
      ))}
    </ul>
  </section>

  <section class="section">
    <div class="section-title section-head">
      <h2>최근 글</h2>
      <a href={url('/blog/')}>전체 보기 →</a>
    </div>
    <PostRows posts={recent} />
  </section>
</Base>
