---
import Base from '../layouts/Base.astro';
import PostRows from '../components/PostRows.astro';
import ToolCards from '../components/ToolCards.astro';
import { PROFILE } from '../consts';
import { TOOLS } from '../data/tools';
import { getPosts } from '../utils/posts';
import { url } from '../utils/url';
import { Image } from 'astro:assets';
import mogu from '../assets/mogu.webp';

const recent = (await getPosts()).slice(0, 6);
---

<Base heading={PROFILE.name} tagline={PROFILE.tagline}>
  <ul class="hero-links" slot="hero">
    {PROFILE.links.map((l) => <li><a class="cta-btn" href={l.url}>{l.label}</a></li>)}
    <li class="hero-more"><a href={url('/about/')}>소개 더 보기 →</a></li>
  </ul>
  <Image
    slot="aside"
    class="hero-art"
    src={mogu}
    widths={[320, 480, 720]}
    sizes="(max-width: 720px) 240px, 320px"
    alt="안경과 나비넥타이를 한 포메라니안 캐릭터 모구가 노트북으로 코딩하는 그림"
    loading="eager"
  />

  <section class="section">
    <div class="section-title section-head">
      <h2>최근 글</h2>
      <a href={url('/blog/')}>전체 보기 →</a>
    </div>
    <PostRows posts={recent} />
  </section>

  <section class="section">
    <h2 class="section-title">유용한 기능</h2>
    <ToolCards items={TOOLS.filter((t) => t.kind === 'tool')} />
  </section>

  <section class="section">
    <h2 class="section-title">쉬어가기</h2>
    <ToolCards items={TOOLS.filter((t) => t.kind === 'game')} />
  </section>
</Base>

<style>
  .hero-more {
    display: flex;
    align-items: center;
    margin-left: 6px;
  }
  .hero-more a {
    font-size: 0.92rem;
    font-weight: 600;
    color: var(--text-muted);
  }
  .hero-more a:hover { color: var(--accent); text-decoration: none; }
</style>
