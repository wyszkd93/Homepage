---
import Base from '../layouts/Base.astro';
import PostList from '../components/PostList.astro';
import { PROFILE } from '../consts';
import { getPosts } from '../utils/posts';
import { url } from '../utils/url';

const recent = (await getPosts()).slice(0, 5);
---

<Base>
  <section class="hero">
    <h1>{PROFILE.name}</h1>
    <p class="tagline">{PROFILE.tagline}</p>
    <ul class="link-row">
      {PROFILE.links.map((l) => <li><a class="pill" href={l.url}>{l.label}</a></li>)}
    </ul>
  </section>

  <section class="section">
    <h2>소개</h2>
    {PROFILE.about.map((p) => <p>{p}</p>)}
  </section>

  <section class="section grid-2">
    <div>
      <h2>관심 분야</h2>
      <ul class="chips">{PROFILE.interests.map((i) => <li>{i}</li>)}</ul>
    </div>
    <div>
      <h2>기술 스택</h2>
      <ul class="chips">{PROFILE.stack.map((s) => <li>{s}</li>)}</ul>
    </div>
  </section>

  <section class="section">
    <h2>프로젝트</h2>
    <ul class="cards">
      {PROFILE.projects.map((p) => (
        <li class="card">
          <h3>{p.url ? <a href={p.url}>{p.name}</a> : p.name}</h3>
          <p>{p.description}</p>
        </li>
      ))}
    </ul>
  </section>

  <section class="section">
    <div class="section-head">
      <h2>최근 글</h2>
      <a href={url('/blog/')}>전체 보기 →</a>
    </div>
    <PostList posts={recent} />
  </section>
</Base>
