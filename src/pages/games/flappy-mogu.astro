  .fl-best strong { color: var(--ink); font-variant-numeric: tabular-nums; }
  .fl-stage { position: relative; border-radius: 12px; overflow: hidden; border: 3px solid #2b2420; touch-action: manipulation; cursor: pointer; user-select: none; }
  #fl-canvas { display: block; width: 100%; aspect-ratio: 216 / 384; image-rendering: pixelated; }
  .fl-overlay {
    position: absolute; inset: 0; display: flex; flex-direction: column; align-items: center; justify-content: flex-start;
    padding-top: 22%; gap: 6px; pointer-events: none;
  }
  .fl-overlay[hidden] { display: none; }
  .fl-title, .fl-sub {
    margin: 0; color: #fff; font-weight: 800; letter-spacing: 0.02em;
    text-shadow: 2px 0 #2b2420, -2px 0 #2b2420, 0 2px #2b2420, 0 -2px #2b2420, 2px 2px #2b2420;
  }
  .fl-title { font-size: clamp(1.5rem, 7vw, 2rem); }
  .fl-sub { font-size: 1rem; animation: fl-blink 1.1s steps(2) infinite; }
  @keyframes fl-blink { 50% { opacity: 0.35; } }
</style>
