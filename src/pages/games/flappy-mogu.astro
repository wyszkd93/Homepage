---
import Base from '../../layouts/Base.astro';
import sprite from '../../assets/flappy-mogu.png';
import Leaderboard from '../../components/Leaderboard.astro';
---

<Base
  title="플래피 모구"
  description="날개 달린 도트 모구가 파닥파닥 날아 기둥 사이를 통과하는 레트로 미니게임"
  heading="플래피 모구"
  tagline="누를 때마다 모구가 파닥! 기둥 사이를 지나가요 · 스페이스, 클릭, 터치"
>
  <div class="fl-wrap">
    <Leaderboard game="flappy-mogu" />
    <div class="fl-bar">
      <span class="fl-best">최고 <strong id="fl-best">0</strong></span>
      <button id="fl-sound" class="tool-btn" type="button" aria-pressed="true">🔊 소리 켬</button>
    </div>
    <div id="fl-stage" class="fl-stage">
      <canvas id="fl-canvas" data-sprite={sprite.src} aria-label="플래피 모구 게임 화면" role="img"></canvas>
      <div id="fl-overlay" class="fl-overlay">
        <p id="fl-title" class="fl-title">플래피 모구</p>
        <p id="fl-sub" class="fl-sub">눌러서 시작</p>
      </div>
    </div>
  </div>
</Base>

<script>
  // 저해상도(288x512) 버퍼에 그린 뒤 스무딩 없이 늘려 붙여 도트 느낌을 낸다.
  const VW = 288;
  const VH = 512;
  const GROUND = 448;
  const PIPE_W = 48;
  const GAP = 150;
  const SPACING = 172;
  const SPEED = 124; // px/s
  const GRAVITY = 1240;
  const FLAP = -400;
  const MAX_FALL = 600;
  const MX = 80; // 모구 중심 x
  const START_Y = 220;
  // 충돌 상자: 머리와 몸통만 (날개·꼬리·발끝은 봐줌). 스프라이트 중심 기준
  const HIT = { l: -12, r: 22, t: -10, b: 14 };
  const FEET = 25; // 중심에서 발끝까지
  const BEST_KEY = 'game:flappy-mogu';

  const DIGITS = [
    '111101101101111', '010110010010111', '111001111100111', '111001111001111', '101101111001001',
    '111100111001111', '111100111101111', '111001001010010', '111101111101111', '111101111001111',
  ];

  const canvas = document.getElementById('fl-canvas') as HTMLCanvasElement;
  const out = canvas.getContext('2d')!;
  const buf = document.createElement('canvas');
  buf.width = VW;
  buf.height = VH;
  const g = buf.getContext('2d')!;
  // 모구 스프라이트 시트: 날개 위·가운데·아래 3장이 가로로 이어져 있음
  const sheet = new Image();
  sheet.src = canvas.dataset.sprite!;
  const FW = 64;
  const FH = 57;
  const FLAP_CYCLE = [0, 1, 2, 1];

  const overlay = document.getElementById('fl-overlay')!;
  const title = document.getElementById('fl-title')!;
  const sub = document.getElementById('fl-sub')!;
  const bestEl = document.getElementById('fl-best')!;
  const soundBtn = document.getElementById('fl-sound')!;

  type Pipe = { x: number; gapY: number; passed: boolean };
  let state: 'ready' | 'play' | 'dead' = 'ready';
  let y = START_Y;
  let vy = 0;
  let pipes: Pipe[] = [];
  let score = 0;
  let best = 0;
  let scroll = 0; // 누적 이동 거리 (배경·땅 무늬용)
  let deadAt = 0;
  let flapAt = 0; // 마지막 날갯짓 시각 (날개를 잠깐 내린 모양으로)
    let sound = true;
  let audio: AudioContext | null = null;
  const stars = Array.from({ length: 28 }, () => [Math.random() * VW, Math.random() * 300, Math.random()]);

  try {
    const s = JSON.parse(localStorage.getItem(BEST_KEY) ?? '{}');
    best = s.best ?? 0;
    sound = s.sound ?? true;
  } catch {}
  const save = () => {
    try {
      localStorage.setItem(BEST_KEY, JSON.stringify({ best, sound }));
    } catch {}
  };
  bestEl.textContent = String(best);

  // ── 8비트 효과음 ──
  function tone(freq: number, to: number, dur: number, type: OscillatorType = 'square', vol = 0.06, delay = 0) {
    if (!sound) return;
    audio ??= new AudioContext();
    const t = audio.currentTime + delay;
    const o = audio.createOscillator();
    const v = audio.createGain();
    o.type = type;
    o.frequency.setValueAtTime(freq, t);
    o.frequency.exponentialRampToValueAtTime(to, t + dur);
    v.gain.setValueAtTime(vol, t);
    v.gain.exponentialRampToValueAtTime(0.0001, t + dur);
    o.connect(v).connect(audio.destination);
    o.start(t);
    o.stop(t + dur + 0.02);
  }
  const sfx = {
    flap: () => tone(480, 760, 0.07),
    point: () => (tone(880, 880, 0.06, 'square', 0.05), tone(1320, 1320, 0.09, 'square', 0.05, 0.06)),
    hit: () => (tone(220, 55, 0.3, 'sawtooth', 0.08), tone(120, 40, 0.35, 'square', 0.05)),
  };
  function setSound(on: boolean) {
    sound = on;
    soundBtn.textContent = on ? '🔊 소리 켬' : '🔇 소리 끔';
    soundBtn.setAttribute('aria-pressed', String(on));
    save();
  }

  function reset() {
    y = START_Y;
    vy = 0;
    pipes = [];
    score = 0;
    for (let i = 0; i < 3; i++) addPipe(VW + 80 + i * SPACING);
  }
  function addPipe(x: number) {
    pipes.push({ x, gapY: 104 + Math.random() * (GROUND - 208 - 104) + GAP / 2, passed: false });
  }

  function flap() {
    if (state === 'dead') {
      if (performance.now() - deadAt < 600) return;
      state = 'ready';
      reset();
      showOverlay('플래피 모구', '눌러서 시작');
      return;
    }
    if (state === 'ready') {
      state = 'play';
      overlay.hidden = true;
    }
    vy = FLAP;
    flapAt = performance.now();
    sfx.flap();
  }

  // 랭킹(Leaderboard)으로 점수 보내기. final: 판이 끝남 → 결과 창이 뜸
  const report = (score: number, final = false) =>
    window.dispatchEvent(new CustomEvent('game:score', { detail: { game: 'flappy-mogu', score, final } }));
  const onRetry = (fn: () => void) =>
    window.addEventListener('game:retry', (e) => (e as CustomEvent<{ game: string }>).detail.game === 'flappy-mogu' && fn());
  onRetry(() => {
    if (state !== 'dead') return;
    deadAt = 0; // 결과 창에서 '다시 하기' → 바로 시작 대기 화면으로
    flap();
  });

  function die() {
    if (state !== 'play') return;
    state = 'dead';
    deadAt = performance.now();
    sfx.hit();
    report(score, true);
    const record = score > best;
    if (record) {
      best = score;
      bestEl.textContent = String(best);
      save();
    }
    setTimeout(() => showOverlay(record && score > 0 ? `새 기록! ${score}` : `점수 ${score}`, '눌러서 다시 하기'), 500);
  }

  function showOverlay(t: string, s: string) {
    title.textContent = t;
    sub.textContent = s;
    overlay.hidden = false;
  }

  function hitsPipe(p: Pipe) {
    // 입구 테두리(좌우 4칸 더 넓음)까지 포함한 기둥 상자와 겹치는지
    if (MX + HIT.r <= p.x - 4 || MX + HIT.l >= p.x + PIPE_W + 4) return false;
    return y + HIT.t < p.gapY - GAP / 2 || y + HIT.b > p.gapY + GAP / 2;
  }

  function update(dt: number) {
    if (state === 'ready') {
      y = START_Y + Math.sin(performance.now() / 260) * 8;
      scroll += SPEED * dt;
      return;
    }
    vy = Math.min(MAX_FALL, vy + GRAVITY * dt);
    y += vy * dt;
    if (state === 'dead') {
      y = Math.min(y, GROUND - FEET);
      return;
    }
    scroll += SPEED * dt;
    for (const p of pipes) {
      p.x -= SPEED * dt;
      if (!p.passed && p.x + PIPE_W < MX) {
        p.passed = true;
        score++;
        sfx.point();
      }
    }
    if (pipes[0].x < -PIPE_W - 4) {
      pipes.shift();
      addPipe(pipes[pipes.length - 1].x + SPACING);
    }
    if (y < -40) y = -40;
    if (y + FEET >= GROUND || pipes.some(hitsPipe)) die();
  }

  // ── 그리기 ──
  const px = (x: number, yy: number, w: number, h: number, c: string) => {
    g.fillStyle = c;
    g.fillRect(Math.round(x), Math.round(yy), w, h);
  };

  function cloud(x: number, cy: number, c: string) {
    px(x + 8, cy, 28, 8, c);
    px(x, cy + 7, 48, 9, c);
    px(x + 16, cy - 7, 16, 8, c);
  }

  function drawPipe(p: Pipe, night: boolean) {
    const body = night ? '#3f8f5a' : '#5bbf5b';
    const light = night ? '#62b07c' : '#8ee08e';
    const dark = night ? '#24563a' : '#2f7a2f';
    const top = p.gapY - GAP / 2;
    const bot = p.gapY + GAP / 2;
    for (const [y0, h] of [[0, top], [bot, GROUND - bot]]) {
      px(p.x + 1, y0, PIPE_W - 2, h, body);
      px(p.x + 5, y0, 5, h, light);
      px(p.x + PIPE_W - 9, y0, 5, h, dark);
      px(p.x, y0, 1, h, dark);
      px(p.x + PIPE_W - 1, y0, 1, h, dark);
    }
    // 입구 테두리
    for (const capY of [top - 18, bot]) {
      px(p.x - 4, capY, PIPE_W + 8, 18, body);
      px(p.x, capY + 1, 5, 16, light);
      px(p.x + PIPE_W - 4, capY + 1, 5, 16, dark);
      px(p.x - 4, capY, PIPE_W + 8, 1, dark);
      px(p.x - 4, capY + 17, PIPE_W + 8, 1, dark);
      px(p.x - 4, capY, 1, 18, dark);
      px(p.x + PIPE_W + 3, capY, 1, 18, dark);
    }
  }

  function drawNumber(n: number, cx: number, top: number, s: number) {
    const str = String(n);
    const w = str.length * 4 * s - s;
    let x = Math.round(cx - w / 2);
    for (const ch of str) {
      const bits = DIGITS[Number(ch)];
      for (let i = 0; i < 15; i++)
        if (bits[i] === '1') {
          const bx = x + (i % 3) * s;
          const by = top + Math.floor(i / 3) * s;
          px(bx + 1, by + 1, s, s, '#2b2420');
          px(bx, by, s, s, '#ffffff');
        }
      x += 4 * s;
    }
  }

  function draw() {
    const night = document.documentElement.dataset.theme === 'dark';
    // 하늘
    const bands = night ? ['#141b33', '#18213d', '#1d2848', '#233056'] : ['#8fd3f4', '#9edaf6', '#afe1f7', '#c2e9f9'];
    bands.forEach((c, i) => px(0, i * 80, VW, i === 3 ? GROUND : 80, c));
    if (night) for (const [sx, sy, tw] of stars) if ((performance.now() / 600 + tw * 10) % 3 > 0.4) px(sx, sy, 1, 1, '#fff6d8');
    // 구름
    const cc = night ? '#2c3a62' : '#ffffff';
    const c1 = (scroll * 0.15) % (VW + 80);
    cloud(VW - c1, 67, cc);
    cloud(VW - ((c1 + 180) % (VW + 80)), 140, cc);
    // 먼 언덕
    const hc = night ? '#22405a' : '#9fd8a8';
    const hd = night ? '#1b3349' : '#86c793';
    for (let x = 0; x < VW; x++) {
      const wx = x + scroll * 0.35;
      const h = 36 + Math.round(Math.sin(wx / 45) * 12 + Math.sin(wx / 17) * 4);
      px(x, GROUND - h, 1, h, (Math.floor(wx / 2) % 9 === 0 ? hd : hc));
    }
    for (const p of pipes) drawPipe(p, night);
    // 땅
    px(0, GROUND, VW, VH - GROUND, night ? '#5a4a3a' : '#e2c38f');
    px(0, GROUND, VW, 8, night ? '#3f8f5a' : '#6cc24a');
    const off = Math.floor(scroll) % 8;
    for (let x = -off; x < VW; x += 8) px(x, GROUND + 8, 4, 4, night ? '#2e6b44' : '#4e9a36');
    for (let x = -off; x < VW; x += 12) px(x + 3, GROUND + 27, 4, 4, night ? '#4a3c2f' : '#cfa86e');
    // 모구: 굴러가지 않게 회전하지 않고, 날개 장면으로만 움직임을 표현
    //  준비: 천천히 파닥 · 날갯짓 직후: 빠르게 한 바퀴 · 떨어질 때: 날개 펴고 활공 · 끝: 날개 내림
    const now = performance.now();
    const since = now - flapAt;
    const frame =
      state === 'dead' ? 2
      : state === 'ready' ? FLAP_CYCLE[Math.floor(now / 160) % 4]
      : since < 240 ? FLAP_CYCLE[Math.floor(since / 60) % 4]
      : vy > 160 ? 0
      : FLAP_CYCLE[Math.floor(now / 110) % 4];
    if (sheet.complete) g.drawImage(sheet, frame * FW, 0, FW, FH, Math.round(MX - FW / 2), Math.round(y - FH / 2), FW, FH);
    if (state === 'play') drawNumber(score, VW / 2, 32, 5);
  }

  function present() {
    out.imageSmoothingEnabled = false;
    out.drawImage(buf, 0, 0, canvas.width, canvas.height);
  }

  function resize() {
    const dpr = window.devicePixelRatio || 1;
    canvas.width = Math.round(canvas.clientWidth * dpr);
    canvas.height = Math.round(canvas.clientWidth * (VH / VW) * dpr);
  }
  new ResizeObserver(resize).observe(canvas);

  let last = performance.now();
  function loop(now: number) {
    const dt = Math.min(1 / 30, (now - last) / 1000);
    last = now;
    update(dt);
    g.imageSmoothingEnabled = false;
    draw();
    present();
    requestAnimationFrame(loop);
  }

  const stage = document.getElementById('fl-stage')!;
  stage.addEventListener('pointerdown', (e) => {
    e.preventDefault();
    flap();
  });
  window.addEventListener('keydown', (e) => {
    const el = e.target instanceof Element ? e.target : null;
    if (el?.closest('input, textarea, select, dialog, button')) return;
    if (['Space', 'ArrowUp', 'KeyW'].includes(e.code)) {
      e.preventDefault();
      if (!e.repeat) flap();
    }
  });
  soundBtn.addEventListener('click', () => setSound(!sound));

  setSound(sound);
  reset();
  resize();
  requestAnimationFrame(loop);
</script>

<style>
  .fl-wrap { max-width: 400px; margin: 0 auto; }
  .fl-bar { display: flex; align-items: center; justify-content: space-between; margin-bottom: 10px; }
  .fl-best { font-size: 0.95rem; color: var(--text-muted); }
  .fl-best strong { color: var(--ink); font-variant-numeric: tabular-nums; }
  .fl-stage { position: relative; border-radius: 12px; overflow: hidden; border: 3px solid #2b2420; touch-action: manipulation; cursor: pointer; user-select: none; }
  #fl-canvas { display: block; width: 100%; aspect-ratio: 288 / 512; image-rendering: pixelated; }
  .fl-overlay {
    position: absolute; inset: 0; display: flex; flex-direction: column; align-items: center; justify-content: flex-start;
    padding-top: 22%; gap: 6px; pointer-events: none;
  }
  .fl-overlay[hidden] { display: none; }
  .fl-title, .fl-sub {
    margin: 0; color: #fff; font-weight: 800; letter-spacing: 0.02em;
    text-shadow: 2px 0 #2b2420, -2px 0 #2b2420, 0 2px #2b2420, 0 -2px #2b2420, 2px 2px #2b2420;
  }
  .fl-title { font-size: clamp(1.5rem, 7vw, 2rem); }
  .fl-sub { font-size: 1rem; animation: fl-blink 1.1s steps(2) infinite; }
  @keyframes fl-blink { 50% { opacity: 0.35; } }
</style>
