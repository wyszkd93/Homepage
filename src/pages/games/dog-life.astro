---
import Base from '../../layouts/Base.astro';
import KakaoShare from '../../components/KakaoShare.astro';
import dogLife from '../../assets/dog-life.jpg';
import { Image } from 'astro:assets';
---

<Base
  title="모구의 견생 한 바퀴"
  description="무작위 강아지로 태어나 견종별 수명 통계를 따라 한평생을 살아 보는 미니게임"
  heading="모구의 견생 한 바퀴"
  tagline="무작위 강아지로 태어나 한평생을 살아 봐요"
  ogImage={dogLife}
>
  <Image
    slot="aside"
    class="hero-art hero-art-sm"
    src={dogLife}
    widths={[200, 300]}
    sizes="(max-width: 720px) 96px, 150px"
    alt="안경 쓴 포메라니안 모구가 강아지의 한평생이 담긴 앨범을 펼쳐 보이는 그림"
    loading="eager"
  />
  <div class="dl">
    <section id="dl-start" class="tool-panel dl-start">
      <p class="dl-intro">
        어떤 견종으로, 어떤 가족에게 갈지는 고를 수 없지만 이름은 직접 지어 줄 수 있어요. 태어나면 1년이 몇 초씩 흐르고, 중간중간 가족이 되어 선택을 하게 돼요.
        한평생은 1~2분이면 끝나요.
      </p>
      <button id="dl-born" class="dl-btn" type="button">🐾 견생으로 태어나기</button>
    </section>

    <section id="dl-naming" class="tool-panel dl-naming" hidden>
      <p class="dl-naming-step">✏️ 이름 짓기</p>
      <p id="dl-naming-born" class="dl-naming-born"></p>
      <form id="dl-naming-form" class="dl-naming-form" autocomplete="off">
        <label for="dl-name-input" class="dl-naming-label">이 아이를 뭐라고 부를까요?</label>
        <div class="dl-naming-row">
          <input id="dl-name-input" class="tool-input dl-name-input" type="text" maxlength="8"  placeholder="이름 (최대 8자)" />
          <button id="dl-name-dice" class="tool-btn" type="button" aria-label="이름 추천 다시 받기" title="추천 다시 받기">🎲</button>
        </div>
        <div id="dl-name-chips" class="dl-name-chips" aria-label="추천 이름"></div>
        <p id="dl-name-err" class="dl-name-err" hidden>이름을 한 글자 이상 적어 주세요.</p>
        <button class="dl-btn" type="submit">📝 견생 등록하기</button>
      </form>
    </section>

    <section id="dl-cert" class="dl-cert" hidden>
      <div class="dl-cert-head">
        <strong>🐾 견생 등록증</strong>
        <span id="dl-cert-no" class="dl-cert-no"></span>
      </div>
      <div class="dl-cert-body">
        <p class="dl-cert-label">이름</p>
        <p class="dl-cert-name-row"><span id="dl-cert-name" class="dl-cert-name"></span><button id="dl-rename" class="dl-rename" type="button">✏️ 이름 바꾸기</button></p>
        <p id="dl-cert-story" class="dl-cert-story"></p>
        <dl id="dl-cert-grid" class="dl-cert-grid"></dl>
        <p class="dl-cert-note">1년이 약 4.5초씩 흘러요. 중간에 가족이 되어 다섯 번 선택하게 돼요.</p>
      </div>
      <div class="dl-cert-btns">
        <button id="dl-reroll" class="tool-btn" type="button">🎲 다시 태어나기</button>
        <button id="dl-go" class="dl-btn" type="button">견생 시작하기</button>
      </div>
    </section>

    <section id="dl-live" class="dl-live" hidden>
      <div class="dl-scene">
        <canvas id="dl-canvas" aria-label="강아지가 가족과 함께 사는 동네 장면" role="img"></canvas>
        <p id="dl-scene-cap" class="dl-scene-cap"></p>
      </div>
      <div class="tool-panel dl-profile">
        <span id="dl-face" class="dl-face" aria-hidden="true">🐶</span>
        <div class="dl-who">
          <p class="dl-name"><strong id="dl-name"></strong> <span id="dl-breed"></span></p>
          <p id="dl-tags" class="dl-tags"></p>
        </div>
        <div class="dl-age">
          <strong id="dl-age">0개월</strong>
          <span id="dl-stage">아기 강아지</span>
        </div>
      </div>

      <div class="tool-panel dl-stats">
        <div class="dl-bars">
          <div class="dl-bar"><span>💚 건강</span><span class="dl-track"><span id="dl-b-health" class="dl-fill" style="--c:#3f9b5a"></span></span></div>
          <div class="dl-bar"><span>😊 행복</span><span class="dl-track"><span id="dl-b-happy" class="dl-fill" style="--c:#f0a92e"></span></span></div>
          <div class="dl-bar"><span>🤝 유대</span><span class="dl-track"><span id="dl-b-bond" class="dl-fill" style="--c:#c0632f"></span></span></div>
        </div>
        <ul class="dl-count">
          <li><span>산책</span><strong id="dl-walks">0</strong></li>
          <li><span>간식</span><strong id="dl-treats">0</strong></li>
          <li><span>친구</span><strong id="dl-friends">0</strong></li>
        </ul>
        <div class="dl-ctrl">
          <span class="dl-ctrl-l">
            <button id="dl-pause" class="tool-btn" type="button">❚❚ 멈춤</button>
            <button id="dl-music" class="tool-btn" type="button" aria-pressed="true">♪ 음악</button>
          </span>
          <span class="dl-speed" role="group" aria-label="빠르기">
            <button class="tool-btn" type="button" data-speed="1" aria-pressed="true">1×</button>
            <button class="tool-btn" type="button" data-speed="2" aria-pressed="false">2×</button>
            <button class="tool-btn" type="button" data-speed="4" aria-pressed="false">4×</button>
          </span>
        </div>
      </div>

      <div id="dl-choice" class="tool-panel dl-choice" hidden>
        <p class="dl-choice-tag">가족의 선택</p>
        <p id="dl-q" class="dl-q"></p>
        <div id="dl-opts" class="dl-opts"></div>
      </div>

      <ol id="dl-log" class="tool-panel dl-log" aria-live="polite"></ol>
    </section>

    <div id="dl-movie" class="dl-movie" hidden>
      <button id="dl-skip" class="dl-skip" type="button">건너뛰기</button>
      <div id="dl-m-intro" class="dl-m-intro">
        <h2 id="dl-m-title"></h2>
        <div id="dl-m-lines"></div>
      </div>
      <div id="dl-m-reel" class="dl-m-reel" hidden>
        <canvas id="dl-m-canvas" aria-hidden="true"></canvas>
        <p id="dl-m-age" class="dl-m-age"></p>
        <p id="dl-m-text" class="dl-m-text"></p>
        <div id="dl-m-bar" class="dl-m-bar"></div>
      </div>
      <p class="dl-m-hint">화면을 누르면 다음으로 넘어가요</p>
    </div>

    <div id="dl-shared" class="dl-shared" hidden>
      <p>👀 친구가 공유한 견생이에요. 나는 어떤 강아지로 태어날까요?</p>
      <button id="dl-mine" class="dl-btn" type="button">🐾 나도 해보기</button>
    </div>

    <section id="dl-end" class="dl-end" hidden>
      <div class="tool-panel dl-end-card">
        <p class="dl-end-icon">🌈</p>
        <p id="dl-end-title" class="dl-end-title"></p>
        <p id="dl-end-text" class="dl-end-text"></p>
        <p id="dl-titles" class="dl-titles" hidden></p>
        <blockquote id="dl-letter" class="dl-letter" hidden></blockquote>
        <ul id="dl-end-stats" class="dl-end-stats"></ul>
        <div class="dl-memories">
          <h2>함께한 기억</h2>
          <ul id="dl-mem"></ul>
        </div>
      </div>
      <KakaoShare title="모구의 견생 한 바퀴" description="무작위 강아지로 태어나 한평생을 살아 봐요" label="카카오톡으로 견생 공유하기" />
      <div class="dl-end-btns">
        <button id="dl-again" class="dl-btn" type="button">🐾 다시 태어나기</button>
      </div>
    </section>

    <p class="dl-note">
      견종별 평균 수명과 견종 비율은 공개 자료(견종 표준, 국내 반려견 등록 통계 등)를 바탕으로 한 대략값이에요.
      한 마리의 일생은 재미를 위한 시뮬레이션이고, 실제 반려견의 건강이나 수명을 알려 주지 않아요.
    </p>
  </div>
</Base>

<script>
  import {
    born, eventsForYear, applyEffect, tick, stageOf, ageText, nameGa, lastWords, choose, titlesOf, BREEDS, NAMES, FAMILIES, PERSONALITIES,
    type Dog, type LifeEvent,
  } from '../../utils/dog-life';
  import { Bgm } from '../../utils/bgm';
  import { DogScene, homeOf, coatName, SEASON_NAME } from '../../utils/dog-scene';
  import { clearShareParams } from '../../lib/share-param';

  const $ = (id: string) => document.getElementById(id)!;
  const KEY = 'game:dog-life';
  const YEAR_MS = 4500; // 1× 기준 1년 = 4.5초

  let dog: Dog | null = null;
  let age = 0;
  let speed = 1;
  let paused = false;
  let waiting = false; // 선택을 기다리는 중
  let queue: LifeEvent[] = [];
  let year = -1;
  let used = new Set<number>();
  let choiceIdx = 0;
  let last = 0;
  let raf = 0;

  const fmt = (n: number) => Math.round(n).toLocaleString('ko-KR');

  function log(icon: string, text: string, at: number, cls = '') {
    const li = document.createElement('li');
    if (cls) li.className = cls;
    const a = document.createElement('span');
    a.className = 'dl-log-age';
    a.textContent = ageText(at);
    const t = document.createElement('span');
    t.textContent = `${icon} ${text}`;
    li.append(a, t);
    $('dl-log').prepend(li);
  }

  function renderLive() {
    if (!dog) return;
    const st = stageOf(age, dog);
    $('dl-age').textContent = ageText(age);
    $('dl-stage').textContent = st.label;
    $('dl-face').textContent = st.icon;
    ($('dl-b-health') as HTMLElement).style.width = `${dog.stats.health}%`;
    ($('dl-b-happy') as HTMLElement).style.width = `${dog.stats.happy}%`;
    ($('dl-b-bond') as HTMLElement).style.width = `${dog.stats.bond}%`;
    $('dl-walks').textContent = fmt(dog.walks);
    $('dl-treats').textContent = fmt(dog.treats);
    $('dl-friends').textContent = String(dog.friends);
  }

  const scene = new DogScene($('dl-canvas') as HTMLCanvasElement);

  // ── 배경음악 (WebAudio로 만든 오르골) ──
  const bgm = new Bgm();
  const MUSIC_KEY = 'game:dog-life:bgm';
  let musicOn = true;
  let lifeRunning = false;
  try { musicOn = localStorage.getItem(MUSIC_KEY) !== '0'; } catch {}
  const musicBtn = $('dl-music');
  const renderMusic = () => {
    musicBtn.textContent = musicOn ? '♪ 음악 켬' : '♪ 음악 끔';
    musicBtn.setAttribute('aria-pressed', String(musicOn));
  };
  renderMusic();
  musicBtn.addEventListener('click', () => {
    musicOn = !musicOn;
    try { localStorage.setItem(MUSIC_KEY, musicOn ? '1' : '0'); } catch {}
    // 음악은 견생이 흘러가는 동안(마지막 장면까지)만 나와요.
    if (musicOn && lifeRunning) bgm.start();
    else bgm.stop();
    renderMusic();
  });
  document.addEventListener('visibilitychange', () => bgm.suspend(document.hidden));
  let memLog: { age: number; icon: string; text: string; key?: string }[] = [];
  let picks: Record<string, number> = {};
  let letter: string[] = [];

  // ── 마지막: 지나온 날들이 스쳐 지나가는 장면 ──
  const LAST_WORDS = [
    '마지막으로 꼬리를 세 번 흔들었어요.',
    '좋아하던 담요 위에서 가족의 손을 핥아 주었어요.',
    '가족 품에 기대어 깊은 숨을 쉬었어요.',
    '창가의 햇살 속에서 편안히 눈을 감았어요.',
  ];
  function playMovie(d: Dog, done: () => void) {
    const movie = $('dl-movie');
    const intro = $('dl-m-intro');
    const reel = $('dl-m-reel');
    const mScene = new DogScene($('dl-m-canvas') as HTMLCanvasElement);
    bgm.setMood('ending');
    mScene.setDog(d);
    const slides = [
      { age: 0, icon: '🍼', text: `${d.family.name}에 ${d.breed.name} '${d.name}'로 왔어요.` },
      ...memLog.slice(-8),
      { age: d.lifespan, icon: '🌈', text: '무지개다리를 건너 모구 친구들에게 갔어요.' },
    ];
    $('dl-m-title').textContent = `마지막 해, ${ageText(d.lifespan)}`;
    const lines: [string, string][] = [
      [`${d.family.name} 곁에서 편안히 잠들었어요.`, ''],
      [LAST_WORDS[Math.floor(Math.random() * LAST_WORDS.length)], ''],
      [`강아지별로 가기 전, ${nameGa(d.name)} 남긴 말`, 'dl-m-letter-h'],
      ...letter.map((t): [string, string] => [`“${t}”`, 'dl-m-letter']),
      ['눈을 감자, 함께한 날들이 스쳐 지나갔어요.', 'dl-m-last'],
    ];
    $('dl-m-lines').innerHTML = '';
    lines.forEach(([t, cls], i) => {
      const p = document.createElement('p');
      p.textContent = t;
      if (cls) p.className = cls;
      p.style.animationDelay = `${0.6 + i * 1.3}s`;
      $('dl-m-lines').append(p);
    });
    const bar = $('dl-m-bar');
    bar.innerHTML = '';
    slides.forEach(() => bar.append(document.createElement('span')));
    intro.hidden = false;
    reel.hidden = true;
    movie.hidden = false;
    document.body.style.overflow = 'hidden';

    let phase: 'intro' | 'reel' = 'intro';
    let idx = -1;
    let slideStart = 0;
    let mraf = 0;
    let introTimer = window.setTimeout(() => toReel(), 2500 + lines.length * 1300 + 2500);
    const SLIDE_MS = 2000;

    function show(i: number, now: number) {
      idx = i;
      slideStart = now;
      const sl = slides[i];
      $('dl-m-age').textContent = ageText(Math.min(sl.age, d.lifespan));
      const t = $('dl-m-text');
      t.classList.remove('is-in');
      void t.offsetWidth;
      t.textContent = `${sl.icon} ${sl.text}`;
      t.classList.add('is-in');
      bar.querySelectorAll('span').forEach((el, k) => el.classList.toggle('on', k <= i));
      mScene.ended = i === slides.length - 1;
      if (!mScene.ended) mScene.say(sl.icon, now);
    }
    function toReel() {
      clearTimeout(introTimer);
      phase = 'reel';
      intro.hidden = true;
      reel.hidden = false;
      const now = performance.now();
      show(0, now);
      mraf = requestAnimationFrame(tickReel);
    }
    function tickReel(now: number) {
      mraf = requestAnimationFrame(tickReel);
      const sl = slides[idx];
      const nextAge = slides[idx + 1]?.age ?? sl.age;
      const t = Math.min(1, (now - slideStart) / SLIDE_MS);
      mScene.frame(now, sl.age + (nextAge - sl.age) * t * 0.3, true);
      if (now - slideStart >= SLIDE_MS + (idx === slides.length - 1 ? 1200 : 0)) next();
    }
    function next() {
      if (phase === 'intro') return toReel();
      if (idx < slides.length - 1) show(idx + 1, performance.now());
      else close();
    }
    function close() {
      clearTimeout(introTimer);
      cancelAnimationFrame(mraf);
      movie.hidden = true;
      document.body.style.overflow = '';
      // 마지막 장면이 끝나면 음악도 천천히 끕니다.
      lifeRunning = false;
      bgm.stop(2.5);
      movie.removeEventListener('click', onTap);
      $('dl-skip').removeEventListener('click', onSkip);
      done();
    }
    const onTap = (e: Event) => { if ((e.target as HTMLElement).id !== 'dl-skip') next(); };
    const onSkip = (e: Event) => { e.stopPropagation(); close(); };
    movie.addEventListener('click', onTap);
    $('dl-skip').addEventListener('click', onSkip);
  }

  // 태어나면 먼저 이름을 짓고, 이름을 받으면 등록증을 보여 줍니다.
  let lastName = '';
  function start() {
    cancelAnimationFrame(raf);
    lifeRunning = false;
    bgm.stop();
    dog = born();
    for (const id of ['dl-start', 'dl-end', 'dl-live', 'dl-shared', 'dl-cert']) $(id).hidden = true;
    document.querySelector<HTMLElement>('.kk-wrap')?.removeAttribute('hidden');
    clearShareParams();
    $('dl-naming-born').textContent = `${whereOf(dog)}에 ${dog.breed.name} ${dog.sex === '수컷' ? '남자아이' : '여자아이'}가 왔어요! ${dog.breed.emoji}`;
    const input = $('dl-name-input') as HTMLInputElement;
    input.value = lastName;
    $('dl-name-err').hidden = true;
    suggestNames();
    $('dl-naming').hidden = false;
    $('dl-naming').scrollIntoView({ behavior: 'smooth', block: 'start' });
    setTimeout(() => input.focus({ preventScroll: true }), 300);
  }

  /** '오피스텔의 혼자 사는 직장인 집사' / 가족 이름에 집이 들어 있으면 가족 이름만 ('마당 있는 시골집') */
  function whereOf(d: Dog) {
    const home = homeOf(d);
    return d.family.name.includes(home) ? d.family.name : `${home}의 ${d.family.name}`;
  }

  function suggestNames() {
    const box = $('dl-name-chips');
    box.innerHTML = '';
    const pool = [...NAMES].sort(() => Math.random() - 0.5).slice(0, 6);
    for (const n of pool) {
      const b = document.createElement('button');
      b.type = 'button';
      b.className = 'dl-name-chip';
      b.textContent = n;
      b.addEventListener('click', () => {
        ($('dl-name-input') as HTMLInputElement).value = n;
        $('dl-name-err').hidden = true;
      });
      box.append(b);
    }
  }

  /** 이름: 앞뒤 공백·제어 문자를 빼고 8자까지 */
  function cleanName(v: string) {
    return [...v.replace(/[\u0000-\u001f\u007f<>]/g, '').replace(/\s+/g, ' ').trim()].slice(0, 8).join('');
  }

  function register() {
    if (!dog) return;
    const name = cleanName(($('dl-name-input') as HTMLInputElement).value);
    if (!name) {
      $('dl-name-err').hidden = false;
      return;
    }
    dog.name = name;
    lastName = name;
    showCert();
  }

  function showCert() {
    const d = dog!;
    const now = new Date();
    const no = `${now.getFullYear()}-${String(Math.floor(Math.random() * 1e6)).padStart(6, '0')}`;
    $('dl-cert-no').textContent = `No. ${no}`;
    $('dl-cert-name').textContent = d.name;
    $('dl-cert-story').textContent =
      `${now.getFullYear()}년 ${now.getMonth() + 1}월, ${whereOf(d)}에 ${d.sex} ${d.breed.name}로 왔어요. ${d.personality.note}.`;
    const grid = $('dl-cert-grid');
    grid.innerHTML = '';
    for (const [k, v] of [
      ['견종', d.breed.name], ['성별', d.sex], ['털색', coatName(d.breed.id)], ['성격', d.personality.name],
      ['가족', d.family.name], ['사는 곳', homeOf(d)], ['견종 평균 수명', `${d.breed.life[0]}~${d.breed.life[1]}년`], ['특징', d.breed.trait],
    ]) {
      const wrap = document.createElement('div');
      const dt = document.createElement('dt');
      dt.textContent = k;
      const dd = document.createElement('dd');
      dd.textContent = v;
      wrap.append(dt, dd);
      grid.append(wrap);
    }
    $('dl-naming').hidden = true;
    $('dl-cert').hidden = false;
    $('dl-cert').scrollIntoView({ behavior: 'smooth', block: 'start' });
  }

  function beginLife() {
    if (!dog) return;
    memLog = [];
    picks = {};
    letter = [];
    age = 0;
    year = -1;
    queue = [];
    used = new Set();
    choiceIdx = 0;
    paused = false;
    waiting = false;
    $('dl-log').innerHTML = '';
    $('dl-name').textContent = dog.name;
    $('dl-breed').textContent = `· ${dog.breed.name} · ${dog.sex}`;
    $('dl-tags').innerHTML = '';
    for (const t of [dog.personality.name, dog.family.name, dog.breed.trait]) {
      const s = document.createElement('span');
      s.textContent = t;
      $('dl-tags').append(s);
    }
    $('dl-pause').textContent = '❚❚ 멈춤';
    $('dl-choice').hidden = true;
    $('dl-cert').hidden = true;
    $('dl-live').hidden = false;
    scene.setDog(dog);
    bgm.setMood('life');
    lifeRunning = true;
    if (musicOn) bgm.start();
    log('✨', `${dog.breed.name} ${dog.personality.name}로 태어났어요. ${dog.personality.note}.`, 0, 'is-memory');
    renderLive();
    $('dl-live').scrollIntoView({ behavior: 'smooth', block: 'start' });
    last = performance.now();
    cancelAnimationFrame(raf);
    raf = requestAnimationFrame(loop);
  }

  function askChoice() {
    const c = dog!.choices[choiceIdx];
    waiting = true;
    $('dl-q').textContent = c.q;
    const box = $('dl-opts');
    box.innerHTML = '';
    for (const o of c.options) {
      const b = document.createElement('button');
      b.type = 'button';
      b.className = 'dl-opt';
      b.textContent = o.label;
      b.addEventListener('click', () => {
        if (!dog) return;
        choose(dog, c, c.options.indexOf(o));
        picks[c.id] = c.options.indexOf(o);
        log('🗳️', `${o.label} → ${o.text}`, age, 'is-choice');
        choiceIdx++;
        waiting = false;
        $('dl-choice').hidden = true;
        renderLive();
        last = performance.now();
      });
      box.append(b);
    }
    $('dl-choice').hidden = false;
    $('dl-choice').scrollIntoView({ behavior: 'smooth', block: 'nearest' });
  }

  function loop(now: number) {
    raf = requestAnimationFrame(loop);
    const dtMs = Math.min(100, now - last);
    last = now;
    if (dog) {
      if (age > dog.lifespan * 0.6) bgm.setMood('senior');
      scene.frame(now, age, !paused && !waiting);
      const home = homeOf(dog);
      const extra = dog.household.extra.length ? ` +${dog.household.extra.length}` : '';
      const who = dog.family.name.includes(home) ? dog.family.name : `${home} · ${dog.family.name}`;
      $('dl-scene-cap').textContent = `${who}${extra}${dog.sibling ? ` · 동생 ${dog.sibling.name}` : ''} · ${SEASON_NAME[Math.floor((age % 1) * 4) % 4]}`;
    }
    if (!dog || paused || waiting) return;
    let next = age + (dtMs / YEAR_MS) * speed;

    // 선택 시점에 닿으면 멈추고 묻기
    const c = dog.choices[choiceIdx];
    if (c && c.age < dog.lifespan - 0.5 && next >= c.age) {
      tick(dog, c.age, c.age - age);
      age = c.age;
      renderLive();
      askChoice();
      return;
    }
    if (c && c.age >= dog.lifespan - 0.5) choiceIdx = dog.choices.length;

    // 새 해가 되면 그해 사건을 준비
    while (Math.floor(next) > year && year + 1 < dog.lifespan) {
      year++;
      queue.push(...eventsForYear(dog, year, used));
    }
    // 지나간 사건을 기록
    queue.sort((a, b) => a.age - b.age);
    while (queue.length && queue[0].age <= next && queue[0].age < dog.lifespan) {
      const e = queue.shift()!;
      applyEffect(dog, e.effect);
      e.apply?.(dog, e.age);
      if (e.rare) dog.rare++;
      log(e.icon, e.rare ? `✨ ${e.text}` : e.text, e.age, e.rare ? 'is-memory is-rare' : e.memory ? 'is-memory' : '');
      scene.say(e.icon, now);
      if (e.memory) {
        dog.memories.push(`${ageText(e.age)} · ${e.text}`);
        memLog.push({ age: e.age, icon: e.icon, text: e.text, key: e.key });
      }
    }
    tick(dog, next, next - age);
    age = next;
    renderLive();
    if (age >= dog.lifespan) finish();
  }

  // 공유 링크에 담는 요약 (짧은 키)
  type Summary = { b: string; n: string; y: number; w: number; t: number; f: number; s: number; fam: string; p: string; e?: string; m?: string[] };

  // 공유 링크는 카카오 모바일 크기 제한(10KB) 안에 들도록 숫자만 짧게 담습니다.
  // 견종.이름.가족.성격.나이(×10).산책.간식.친구.점수 (목록의 번호, 직접 지은 이름은 n+base64url)
  function packShare(d: Dog, x: Summary) {
    return [
      BREEDS.indexOf(d.breed), packName(d.name), FAMILIES.indexOf(d.family), PERSONALITIES.indexOf(d.personality),
      Math.round(x.y * 10), x.w, x.t, x.f, x.s,
    ].join('.');
  }
  // 이름: 추천 목록에 있으면 번호, 직접 지은 이름이면 'n' + base64url(UTF-8)
  function packName(n: string) {
    const i = NAMES.indexOf(n);
    if (i >= 0) return String(i);
    const bin = String.fromCharCode(...new TextEncoder().encode(n));
    return 'n' + btoa(bin).replace(/\+/g, '-').replace(/\//g, '_').replace(/=+$/, '');
  }
  function unpackName(v: string) {
    if (/^\d+$/.test(v)) return NAMES[Number(v)];
    try {
      const b = atob(v.slice(1).replace(/-/g, '+').replace(/_/g, '/'));
      return cleanName(new TextDecoder().decode(Uint8Array.from(b, (c) => c.charCodeAt(0)))) || undefined;
    } catch {
      return undefined;
    }
  }
  function unpackShare(v: string | null): Summary | null {
    if (!v || !/^\d+\.(\d+|n[A-Za-z0-9_-]{1,64})(\.\d+){7}$/.test(v)) return null;
    const parts = v.split('.');
    const [bi, , fi, pi, y10, w, t, f, sc] = parts.map(Number);
    const breed = BREEDS[bi], name = unpackName(parts[1]), fam = FAMILIES[fi], per = PERSONALITIES[pi];
    if (!breed || !name || !fam || !per || y10 > 300 || sc > 100) return null;
    return { b: breed.name, n: name, y: y10 / 10, w, t, f, s: sc, fam: fam.name, p: per.name };
  }

  /** 마지막 화면을 그립니다. 내 견생이든 친구가 공유한 견생이든 같은 화면을 씁니다. */
  function renderEnd(x: Summary) {
    $('dl-end-title').textContent = `${x.b} '${x.n}'의 견생`;
    $('dl-end-text').textContent =
      `${x.fam} 곁에서 ${ageText(x.y)}을 살고 무지개다리를 건넜어요. 지금쯤 모구와 함께 들판을 뛰어다니고 있을 거예요.`;
    const stats = [
      ['함께한 시간', ageText(x.y)],
      ['산책', `${fmt(x.w)}번`],
      ['간식', `${fmt(x.t)}개`],
      ['친구', `${x.f}마리`],
      ['행복 점수', `${x.s}점`],
    ];
    $('dl-end-stats').innerHTML = '';
    for (const [k, v] of stats) {
      const li = document.createElement('li');
      const a = document.createElement('span');
      a.textContent = k;
      const b = document.createElement('strong');
      b.textContent = v;
      li.append(a, b);
      $('dl-end-stats').append(li);
    }
    $('dl-mem').innerHTML = '';
    for (const m of x.m ?? []) {
      const li = document.createElement('li');
      li.textContent = m;
      $('dl-mem').append(li);
    }
    ($('dl-mem').closest('.dl-memories') as HTMLElement).hidden = !(x.m ?? []).length;
    return stats;
  }

  function finish() {
    if (!dog) return;
    cancelAnimationFrame(raf);
    const d = dog;
    age = d.lifespan;
    letter = lastWords(d, memLog, picks);
    log('🌈', `${nameGa(d.name)} 가족 곁에서 편안히 잠들었어요.`, age, 'is-memory');
    log('💌', `“${letter.join(' ')}”`, age, 'is-memory');
    const score = Math.round((d.stats.happy + d.stats.bond) / 2);
    const sum: Summary = {
      b: d.breed.name, n: d.name, y: Math.round(age * 100) / 100, w: Math.round(d.walks), t: Math.round(d.treats),
      f: d.friends, s: score, fam: d.family.name, p: d.personality.name, e: d.breed.emoji, m: d.memories.slice(-3),
    };
    const stats = renderEnd(sum);
    const titles = titlesOf(d, memLog.length);
    $('dl-titles').innerHTML = '';
    for (const t of titles) {
      const span = document.createElement('span');
      span.textContent = t;
      $('dl-titles').append(span);
    }
    $('dl-titles').hidden = false;
    const lt = $('dl-letter');
    lt.innerHTML = '';
    const h = document.createElement('p');
    h.className = 'dl-letter-h';
    h.textContent = `💌 강아지별로 가기 전, ${nameGa(d.name)} 남긴 말`;
    lt.append(h);
    for (const t of letter) {
      const p = document.createElement('p');
      p.textContent = t;
      lt.append(p);
    }
    lt.hidden = false;
    $('dl-shared').hidden = true;
    playMovie(d, () => {
      $('dl-live').hidden = true;
      $('dl-end').hidden = false;
      $('dl-end').scrollIntoView({ behavior: 'smooth', block: 'start' });
    });

    window.dispatchEvent(
      new CustomEvent('share:update', {
        detail: {
          title: `${d.breed.name} '${d.name}'의 견생 ${ageText(age)}`,
          // 카드 아래 목록(itemContent)은 누르면 카카오 앱 기본 주소(https://wyszkd93.github.io)로 갑니다.
          text: `${titles.join(' · ')} · 행복 점수 ${score}점. 나는 어떤 강아지로 태어날까?`,
          items: stats.slice(0, 4).map(([item, itemOp]) => ({ item, itemOp })),
          image: () => drawCard(d, stats, score),
          viewQuery: `r=${packShare(d, sum)}`,
        },
      }),
    );
    dog = null;
  }

  // ── 지난 견생 기록 (이 브라우저에만 저장) ──
  // ── 공유 카드 그림 (800×800) ──
  async function drawCard(d: Dog, stats: string[][], score: number): Promise<Blob | null> {
    try { await document.fonts?.ready; } catch {}
    const W = 800;
    const c = document.createElement('canvas');
    c.width = W;
    c.height = W;
    const ctx = c.getContext('2d');
    if (!ctx) return null;
    const F = "'Pretendard Variable', Pretendard, -apple-system, 'Apple SD Gothic Neo', 'Noto Sans KR', sans-serif";
    const g = ctx.createLinearGradient(0, 0, W, W);
    g.addColorStop(0, '#ffe9d2');
    g.addColorStop(1, '#e3f1ef');
    ctx.fillStyle = g;
    ctx.fillRect(0, 0, W, W);
    ctx.fillStyle = '#fff';
    ctx.beginPath();
    ctx.roundRect(36, 36, W - 72, W - 72, 32);
    ctx.fill();
    ctx.textAlign = 'center';
    ctx.textBaseline = 'middle';
    ctx.fillStyle = '#c0632f';
    ctx.font = `700 26px ${F}`;
    ctx.fillText('🐾 모구의 견생 한 바퀴', W / 2, 96);
    ctx.font = `120px ${F}`;
    ctx.fillText(d.breed.emoji, W / 2, 210);
    ctx.fillStyle = '#2b2420';
    ctx.font = `800 44px ${F}`;
    ctx.fillText(`${d.breed.name} '${d.name}'`, W / 2, 316, W - 160);
    ctx.fillStyle = '#7a6f67';
    ctx.font = `600 24px ${F}`;
    ctx.fillText(`${d.personality.name} · ${d.family.name}`, W / 2, 362, W - 160);
    const rows = stats.slice(0, 4);
    rows.forEach(([k, v], i) => {
      const x = 96 + (i % 2) * 312;
      const y = 420 + Math.floor(i / 2) * 104;
      ctx.fillStyle = '#faf6f0';
      ctx.beginPath();
      ctx.roundRect(x, y, 296, 88, 18);
      ctx.fill();
      ctx.fillStyle = '#7a6f67';
      ctx.font = `600 20px ${F}`;
      ctx.fillText(k, x + 148, y + 28);
      ctx.fillStyle = '#2b2420';
      ctx.font = `800 30px ${F}`;
      ctx.fillText(v, x + 148, y + 62);
    });
    ctx.fillStyle = '#e09a1a';
    ctx.font = `800 30px ${F}`;
    ctx.fillText(`행복 점수 ${score}점`, W / 2, 664);
    ctx.fillStyle = '#a69a90';
    ctx.font = `500 18px ${F}`;
    ctx.fillText('wyszkd93.github.io/Homepage · 재미로 보는 시뮬레이션', W / 2, 730);
    return new Promise((resolve) => c.toBlob((b) => resolve(b), 'image/png'));
  }

  // ── 버튼 ──
  $('dl-born').addEventListener('click', start);
  // 등록증의 '다시 태어나기': 이름은 그대로 두고 견종·가족·집·성격만 새로 뽑아요.
  $('dl-reroll').addEventListener('click', () => {
    const name = dog?.name || lastName;
    cancelAnimationFrame(raf);
    dog = born();
    if (name) dog.name = name;
    showCert();
  });
  $('dl-rename').addEventListener('click', () => {
    $('dl-cert').hidden = true;
    $('dl-naming').hidden = false;
    $('dl-naming').scrollIntoView({ behavior: 'smooth', block: 'start' });
  });
  $('dl-name-dice').addEventListener('click', suggestNames);
  $('dl-naming-form').addEventListener('submit', (e) => {
    e.preventDefault();
    register();
  });
  $('dl-go').addEventListener('click', beginLife);
  $('dl-again').addEventListener('click', start);
  $('dl-pause').addEventListener('click', () => {
    paused = !paused;
    $('dl-pause').textContent = paused ? '▶ 계속' : '❚❚ 멈춤';
    last = performance.now();
  });
  for (const b of document.querySelectorAll<HTMLButtonElement>('[data-speed]')) {
    b.addEventListener('click', () => {
      speed = Number(b.dataset.speed);
      for (const o of document.querySelectorAll<HTMLButtonElement>('[data-speed]')) o.setAttribute('aria-pressed', String(o === b));
    });
  }
  // 다른 탭으로 가면 잠시 멈춤
  document.addEventListener('visibilitychange', () => {
    if (!document.hidden) last = performance.now();
  });
  // 지난 견생 기록은 저장하지 않아요. 예전에 저장된 기록이 있으면 지웁니다.
  try { localStorage.removeItem(KEY); } catch {}

  // 친구가 공유한 견생(?r=)으로 들어오면 그 마지막 화면을 보여 줍니다. 저장은 하지 않아요.
  const shared = unpackShare(new URLSearchParams(location.search).get('r'));
  if (shared) {
    renderEnd(shared);
    $('dl-letter').hidden = true;
    $('dl-titles').hidden = true;
    $('dl-start').hidden = true;
    $('dl-end').hidden = false;
    $('dl-shared').hidden = false;
    document.querySelector<HTMLElement>('.kk-wrap')?.setAttribute('hidden', '');
  } else {
    clearShareParams();
  }
  $('dl-mine').addEventListener('click', () => {
    $('dl-shared').hidden = true;
    $('dl-end').hidden = true;
    $('dl-start').hidden = false;
    document.querySelector<HTMLElement>('.kk-wrap')?.removeAttribute('hidden');
    clearShareParams();
    $('dl-start').scrollIntoView({ behavior: 'smooth', block: 'start' });
  });
</script>

