---
import Base from '../../layouts/Base.astro';
import KakaoShare from '../../components/KakaoShare.astro';
import dogLife from '../../assets/dog-life.jpg';
import { Image } from 'astro:assets';
---

<Base
  title="모구의 견생 한 바퀴"
  description="무작위 강아지로 태어나 견종별 수명 통계를 따라 한평생을 살아 보는 미니게임"
  heading="모구의 견생 한 바퀴"
  tagline="무작위 강아지로 태어나 한평생을 살아 봐요"
  ogImage={dogLife}
>
  <Image
    slot="aside"
    class="hero-art hero-art-sm"
    src={dogLife}
    widths={[200, 300]}
    sizes="(max-width: 720px) 96px, 150px"
    alt="안경 쓴 포메라니안 모구가 강아지의 한평생이 담긴 앨범을 펼쳐 보이는 그림"
    loading="eager"
  />
  <div class="dl">
    <section id="dl-start" class="tool-panel dl-start">
      <p class="dl-intro">
        어떤 견종으로, 어떤 가족에게 갈지는 고를 수 없어요. 태어나면 1년이 몇 초씩 흐르고, 중간중간 가족이 되어 선택을 하게 돼요.
        한평생은 1~2분이면 끝나요.
      </p>
      <button id="dl-born" class="dl-btn" type="button">🐾 태어나기</button>
      <div id="dl-past" class="dl-past" hidden>
        <h2>지난 견생</h2>
        <ul id="dl-past-list"></ul>
      </div>
    </section>

    <section id="dl-live" class="dl-live" hidden>
      <div class="tool-panel dl-profile">
        <span id="dl-face" class="dl-face" aria-hidden="true">🐶</span>
        <div class="dl-who">
          <p class="dl-name"><strong id="dl-name"></strong> <span id="dl-breed"></span></p>
          <p id="dl-tags" class="dl-tags"></p>
        </div>
        <div class="dl-age">
          <strong id="dl-age">0개월</strong>
          <span id="dl-stage">아기 강아지</span>
        </div>
      </div>

      <div class="tool-panel dl-stats">
        <div class="dl-bars">
          <div class="dl-bar"><span>💚 건강</span><span class="dl-track"><span id="dl-b-health" class="dl-fill" style="--c:#3f9b5a"></span></span></div>
          <div class="dl-bar"><span>😊 행복</span><span class="dl-track"><span id="dl-b-happy" class="dl-fill" style="--c:#f0a92e"></span></span></div>
          <div class="dl-bar"><span>🤝 유대</span><span class="dl-track"><span id="dl-b-bond" class="dl-fill" style="--c:#c0632f"></span></span></div>
        </div>
        <ul class="dl-count">
          <li><span>산책</span><strong id="dl-walks">0</strong></li>
          <li><span>간식</span><strong id="dl-treats">0</strong></li>
          <li><span>친구</span><strong id="dl-friends">0</strong></li>
        </ul>
        <div class="dl-ctrl">
          <button id="dl-pause" class="tool-btn" type="button">❚❚ 멈춤</button>
          <span class="dl-speed" role="group" aria-label="빠르기">
            <button class="tool-btn" type="button" data-speed="1" aria-pressed="true">1×</button>
            <button class="tool-btn" type="button" data-speed="2" aria-pressed="false">2×</button>
            <button class="tool-btn" type="button" data-speed="4" aria-pressed="false">4×</button>
          </span>
        </div>
      </div>

      <div id="dl-choice" class="tool-panel dl-choice" hidden>
        <p class="dl-choice-tag">가족의 선택</p>
        <p id="dl-q" class="dl-q"></p>
        <div id="dl-opts" class="dl-opts"></div>
      </div>

      <ol id="dl-log" class="tool-panel dl-log" aria-live="polite"></ol>
    </section>

    <div id="dl-shared" class="dl-shared" hidden>
      <p>👀 친구가 공유한 견생이에요. 나는 어떤 강아지로 태어날까요?</p>
      <button id="dl-mine" class="dl-btn" type="button">🐾 나도 해보기</button>
    </div>

    <section id="dl-end" class="dl-end" hidden>
      <div class="tool-panel dl-end-card">
        <p class="dl-end-icon">🌈</p>
        <p id="dl-end-title" class="dl-end-title"></p>
        <p id="dl-end-text" class="dl-end-text"></p>
        <ul id="dl-end-stats" class="dl-end-stats"></ul>
        <div class="dl-memories">
          <h2>함께한 기억</h2>
          <ul id="dl-mem"></ul>
        </div>
      </div>
      <KakaoShare title="모구의 견생 한 바퀴" description="무작위 강아지로 태어나 한평생을 살아 봐요" label="카카오톡으로 견생 공유하기" />
      <div class="dl-end-btns">
        <button id="dl-again" class="dl-btn" type="button">🐾 다시 태어나기</button>
      </div>
    </section>

    <p class="dl-note">
      견종별 평균 수명과 견종 비율은 공개 자료(견종 표준, 국내 반려견 등록 통계 등)를 바탕으로 한 대략값이에요.
      한 마리의 일생은 재미를 위한 시뮬레이션이고, 실제 반려견의 건강이나 수명을 알려 주지 않아요.
    </p>
  </div>
</Base>

<script>
  import {
    born, eventsForYear, applyEffect, tick, stageOf, ageText, nameGa, CHOICES, BREEDS, NAMES, FAMILIES, PERSONALITIES,
    type Dog, type LifeEvent,
  } from '../../utils/dog-life';
  import { clearShareParams } from '../../lib/share-param';

  const $ = (id: string) => document.getElementById(id)!;
  const KEY = 'game:dog-life';
  const YEAR_MS = 4500; // 1× 기준 1년 = 4.5초

  let dog: Dog | null = null;
  let age = 0;
  let speed = 1;
  let paused = false;
  let waiting = false; // 선택을 기다리는 중
  let queue: LifeEvent[] = [];
  let year = -1;
  let used = new Set<number>();
  let choiceIdx = 0;
  let last = 0;
  let raf = 0;

  const fmt = (n: number) => Math.round(n).toLocaleString('ko-KR');

  function log(icon: string, text: string, at: number, cls = '') {
    const li = document.createElement('li');
    if (cls) li.className = cls;
    const a = document.createElement('span');
    a.className = 'dl-log-age';
    a.textContent = ageText(at);
    const t = document.createElement('span');
    t.textContent = `${icon} ${text}`;
    li.append(a, t);
    $('dl-log').prepend(li);
  }

  function renderLive() {
    if (!dog) return;
    const st = stageOf(age, dog);
    $('dl-age').textContent = ageText(age);
    $('dl-stage').textContent = st.label;
    $('dl-face').textContent = st.icon;
    ($('dl-b-health') as HTMLElement).style.width = `${dog.stats.health}%`;
    ($('dl-b-happy') as HTMLElement).style.width = `${dog.stats.happy}%`;
    ($('dl-b-bond') as HTMLElement).style.width = `${dog.stats.bond}%`;
    $('dl-walks').textContent = fmt(dog.walks);
    $('dl-treats').textContent = fmt(dog.treats);
    $('dl-friends').textContent = String(dog.friends);
  }

  function start() {
    dog = born();
    age = 0;
    year = -1;
    queue = [];
    used = new Set();
    choiceIdx = 0;
    paused = false;
    waiting = false;
    $('dl-log').innerHTML = '';
    $('dl-name').textContent = dog.name;
    $('dl-breed').textContent = `· ${dog.breed.name}`;
    $('dl-tags').innerHTML = '';
    for (const t of [dog.personality.name, dog.family.name, dog.breed.trait]) {
      const s = document.createElement('span');
      s.textContent = t;
      $('dl-tags').append(s);
    }
    $('dl-pause').textContent = '❚❚ 멈춤';
    $('dl-choice').hidden = true;
    $('dl-start').hidden = true;
    $('dl-end').hidden = true;
    $('dl-shared').hidden = true;
    document.querySelector<HTMLElement>('.kk-wrap')?.removeAttribute('hidden');
    clearShareParams();
    $('dl-live').hidden = false;
    log('✨', `${dog.breed.name} ${dog.personality.name}로 태어났어요. ${dog.personality.note}.`, 0, 'is-memory');
    renderLive();
    $('dl-live').scrollIntoView({ behavior: 'smooth', block: 'start' });
    last = performance.now();
    cancelAnimationFrame(raf);
    raf = requestAnimationFrame(loop);
  }

  function askChoice() {
    const c = CHOICES[choiceIdx];
    waiting = true;
    $('dl-q').textContent = c.q;
    const box = $('dl-opts');
    box.innerHTML = '';
    for (const o of c.options) {
      const b = document.createElement('button');
      b.type = 'button';
      b.className = 'dl-opt';
      b.textContent = o.label;
      b.addEventListener('click', () => {
        if (!dog) return;
        applyEffect(dog, o.effect);
        log('🗳️', `${o.label} → ${o.text}`, age, 'is-choice');
        choiceIdx++;
        waiting = false;
        $('dl-choice').hidden = true;
        renderLive();
        last = performance.now();
      });
      box.append(b);
    }
    $('dl-choice').hidden = false;
    $('dl-choice').scrollIntoView({ behavior: 'smooth', block: 'nearest' });
  }

  function loop(now: number) {
    raf = requestAnimationFrame(loop);
    const dtMs = Math.min(100, now - last);
    last = now;
    if (!dog || paused || waiting) return;
    let next = age + (dtMs / YEAR_MS) * speed;

    // 선택 시점에 닿으면 멈추고 묻기
    const c = CHOICES[choiceIdx];
    if (c && c.age < dog.lifespan - 0.5 && next >= c.age) {
      tick(dog, c.age, c.age - age);
      age = c.age;
      renderLive();
      askChoice();
      return;
    }
    if (c && c.age >= dog.lifespan - 0.5) choiceIdx = CHOICES.length;

    // 새 해가 되면 그해 사건을 준비
    while (Math.floor(next) > year && year + 1 < dog.lifespan) {
      year++;
      queue.push(...eventsForYear(dog, year, used));
    }
    // 지나간 사건을 기록
    queue.sort((a, b) => a.age - b.age);
    while (queue.length && queue[0].age <= next && queue[0].age < dog.lifespan) {
      const e = queue.shift()!;
      applyEffect(dog, e.effect);
      log(e.icon, e.text, e.age, e.memory ? 'is-memory' : '');
      if (e.memory) dog.memories.push(`${ageText(e.age)} · ${e.text}`);
    }
    tick(dog, next, next - age);
    age = next;
    renderLive();
    if (age >= dog.lifespan) finish();
  }

  // 공유 링크에 담는 요약 (짧은 키)
  type Summary = { b: string; n: string; y: number; w: number; t: number; f: number; s: number; fam: string; p: string; e?: string; m?: string[] };

  // 공유 링크는 카카오 모바일 크기 제한(10KB) 안에 들도록 숫자만 짧게 담습니다.
  // 견종.이름.가족.성격.나이(×10).산책.간식.친구.점수 (목록의 번호)
  function packShare(d: Dog, x: Summary) {
    return [
      BREEDS.indexOf(d.breed), NAMES.indexOf(d.name), FAMILIES.indexOf(d.family), PERSONALITIES.indexOf(d.personality),
      Math.round(x.y * 10), x.w, x.t, x.f, x.s,
    ].join('.');
  }
  function unpackShare(v: string | null): Summary | null {
    if (!v || !/^\d+(\.\d+){8}$/.test(v)) return null;
    const [bi, ni, fi, pi, y10, w, t, f, sc] = v.split('.').map(Number);
    const breed = BREEDS[bi], name = NAMES[ni], fam = FAMILIES[fi], per = PERSONALITIES[pi];
    if (!breed || !name || !fam || !per || y10 > 300 || sc > 100) return null;
    return { b: breed.name, n: name, y: y10 / 10, w, t, f, s: sc, fam: fam.name, p: per.name };
  }

  /** 마지막 화면을 그립니다. 내 견생이든 친구가 공유한 견생이든 같은 화면을 씁니다. */
  function renderEnd(x: Summary) {
    $('dl-end-title').textContent = `${x.b} '${x.n}'의 견생`;
    $('dl-end-text').textContent =
      `${x.fam}에서 ${ageText(x.y)}을 살고 무지개다리를 건넜어요. 지금쯤 모구와 함께 들판을 뛰어다니고 있을 거예요.`;
    const stats = [
      ['함께한 시간', ageText(x.y)],
      ['산책', `${fmt(x.w)}번`],
      ['간식', `${fmt(x.t)}개`],
      ['친구', `${x.f}마리`],
      ['행복 점수', `${x.s}점`],
    ];
    $('dl-end-stats').innerHTML = '';
    for (const [k, v] of stats) {
      const li = document.createElement('li');
      const a = document.createElement('span');
      a.textContent = k;
      const b = document.createElement('strong');
      b.textContent = v;
      li.append(a, b);
      $('dl-end-stats').append(li);
    }
    $('dl-mem').innerHTML = '';
    for (const m of x.m ?? []) {
      const li = document.createElement('li');
      li.textContent = m;
      $('dl-mem').append(li);
    }
    ($('dl-mem').closest('.dl-memories') as HTMLElement).hidden = !(x.m ?? []).length;
    return stats;
  }

  function finish() {
    if (!dog) return;
    cancelAnimationFrame(raf);
    const d = dog;
    age = d.lifespan;
    log('🌈', `${nameGa(d.name)} 가족 곁에서 편안히 잠들었어요.`, age, 'is-memory');
    const score = Math.round((d.stats.happy + d.stats.bond) / 2);
    const sum: Summary = {
      b: d.breed.name, n: d.name, y: Math.round(age * 100) / 100, w: Math.round(d.walks), t: Math.round(d.treats),
      f: d.friends, s: score, fam: d.family.name, p: d.personality.name, e: d.breed.emoji, m: d.memories.slice(-3),
    };
    const stats = renderEnd(sum);
    $('dl-shared').hidden = true;
    $('dl-live').hidden = true;
    $('dl-end').hidden = false;
    $('dl-end').scrollIntoView({ behavior: 'smooth', block: 'start' });

    saveLife({ breed: d.breed.name, name: d.name, years: Math.round(age * 10) / 10, walks: Math.round(d.walks), score });
    window.dispatchEvent(
      new CustomEvent('share:update', {
        detail: {
          title: `${d.breed.name} '${d.name}'의 견생 ${ageText(age)}`,
          // 카드 아래 목록(itemContent)은 누르면 앱 기본 주소로 가서 404가 나므로 쓰지 않습니다.
          text: `산책 ${fmt(d.walks)}번 · 간식 ${fmt(d.treats)}개 · 친구 ${d.friends}마리 · 행복 ${score}점`,
          image: () => drawCard(d, stats, score),
          viewQuery: `r=${packShare(d, sum)}`,
        },
      }),
    );
    dog = null;
  }

  // ── 지난 견생 기록 (이 브라우저에만 저장) ──
  type Past = { breed: string; name: string; years: number; walks: number; score: number; at?: number };
  function loadPast(): Past[] {
    try { return JSON.parse(localStorage.getItem(KEY) ?? '[]'); } catch { return []; }
  }
  function saveLife(p: Past) {
    const list = [{ ...p, at: Date.now() }, ...loadPast()].slice(0, 10);
    try { localStorage.setItem(KEY, JSON.stringify(list)); } catch {}
    renderPast();
  }
  function renderPast() {
    const list = loadPast();
    $('dl-past').hidden = list.length === 0;
    $('dl-past-list').innerHTML = '';
    for (const p of list) {
      const li = document.createElement('li');
      li.textContent = `${p.breed} '${p.name}' · ${p.years}년 · 산책 ${fmt(p.walks)}번 · 행복 ${p.score}점`;
      $('dl-past-list').append(li);
    }
  }

  // ── 공유 카드 그림 (800×800) ──
  async function drawCard(d: Dog, stats: string[][], score: number): Promise<Blob | null> {
    try { await document.fonts?.ready; } catch {}
    const W = 800;
    const c = document.createElement('canvas');
    c.width = W;
    c.height = W;
    const ctx = c.getContext('2d');
    if (!ctx) return null;
    const F = "'Pretendard Variable', Pretendard, -apple-system, 'Apple SD Gothic Neo', 'Noto Sans KR', sans-serif";
    const g = ctx.createLinearGradient(0, 0, W, W);
    g.addColorStop(0, '#ffe9d2');
    g.addColorStop(1, '#e3f1ef');
    ctx.fillStyle = g;
    ctx.fillRect(0, 0, W, W);
    ctx.fillStyle = '#fff';
    ctx.beginPath();
    ctx.roundRect(36, 36, W - 72, W - 72, 32);
    ctx.fill();
    ctx.textAlign = 'center';
    ctx.textBaseline = 'middle';
    ctx.fillStyle = '#c0632f';
    ctx.font = `700 26px ${F}`;
    ctx.fillText('🐾 모구의 견생 한 바퀴', W / 2, 96);
    ctx.font = `120px ${F}`;
    ctx.fillText(d.breed.emoji, W / 2, 210);
    ctx.fillStyle = '#2b2420';
    ctx.font = `800 44px ${F}`;
    ctx.fillText(`${d.breed.name} '${d.name}'`, W / 2, 316, W - 160);
    ctx.fillStyle = '#7a6f67';
    ctx.font = `600 24px ${F}`;
    ctx.fillText(`${d.personality.name} · ${d.family.name}`, W / 2, 362, W - 160);
    const rows = stats.slice(0, 4);
    rows.forEach(([k, v], i) => {
      const x = 96 + (i % 2) * 312;
      const y = 420 + Math.floor(i / 2) * 104;
      ctx.fillStyle = '#faf6f0';
      ctx.beginPath();
      ctx.roundRect(x, y, 296, 88, 18);
      ctx.fill();
      ctx.fillStyle = '#7a6f67';
      ctx.font = `600 20px ${F}`;
      ctx.fillText(k, x + 148, y + 28);
      ctx.fillStyle = '#2b2420';
      ctx.font = `800 30px ${F}`;
      ctx.fillText(v, x + 148, y + 62);
    });
    ctx.fillStyle = '#e09a1a';
    ctx.font = `800 30px ${F}`;
    ctx.fillText(`행복 점수 ${score}점`, W / 2, 664);
    ctx.fillStyle = '#a69a90';
    ctx.font = `500 18px ${F}`;
    ctx.fillText('wyszkd93.github.io/Homepage · 재미로 보는 시뮬레이션', W / 2, 730);
    return new Promise((resolve) => c.toBlob((b) => resolve(b), 'image/png'));
  }

  // ── 버튼 ──
  $('dl-born').addEventListener('click', start);
  $('dl-again').addEventListener('click', start);
  $('dl-pause').addEventListener('click', () => {
    paused = !paused;
    $('dl-pause').textContent = paused ? '▶ 계속' : '❚❚ 멈춤';
    last = performance.now();
  });
  for (const b of document.querySelectorAll<HTMLButtonElement>('[data-speed]')) {
    b.addEventListener('click', () => {
      speed = Number(b.dataset.speed);
      for (const o of document.querySelectorAll<HTMLButtonElement>('[data-speed]')) o.setAttribute('aria-pressed', String(o === b));
    });
  }
  // 다른 탭으로 가면 잠시 멈춤
  document.addEventListener('visibilitychange', () => {
    if (!document.hidden) last = performance.now();
  });
  renderPast();

  // 친구가 공유한 견생(?r=)으로 들어오면 그 마지막 화면을 보여 줍니다. 저장은 하지 않아요.
  const shared = unpackShare(new URLSearchParams(location.search).get('r'));
  if (shared) {
    renderEnd(shared);
    $('dl-start').hidden = true;
    $('dl-end').hidden = false;
    $('dl-shared').hidden = false;
    document.querySelector<HTMLElement>('.kk-wrap')?.setAttribute('hidden', '');
  } else {
    clearShareParams();
  }
  $('dl-mine').addEventListener('click', () => {
    $('dl-shared').hidden = true;
    $('dl-end').hidden = true;
    $('dl-start').hidden = false;
    document.querySelector<HTMLElement>('.kk-wrap')?.removeAttribute('hidden');
    clearShareParams();
    $('dl-start').scrollIntoView({ behavior: 'smooth', block: 'start' });
  });
</script>

<style>
  .dl { max-width: 760px; margin: 0 auto; }
  .dl-intro { margin: 0 0 16px; line-height: 1.8; color: var(--ink-muted); }
  .dl-btn {
    padding: 12px 24px;
    border: 0;
    border-radius: 999px;
    background: var(--accent);
    color: #fff;
    font: inherit;
    font-weight: 700;
    font-size: 1rem;
    cursor: pointer;
  }
  :global(:root[data-theme='dark']) .dl-btn { color: #181412; }
  .dl-btn:hover { filter: brightness(1.08); }
  .dl-past { margin-top: 20px; }
  .dl-past[hidden] { display: none; }
  .dl-past h2, .dl-memories h2 { font-size: 0.95rem; margin: 0 0 8px; }
  .dl-past ul, .dl-memories ul { margin: 0; padding-left: 1.2em; color: var(--ink-muted); font-size: 0.9rem; line-height: 1.8; }

  .dl-live[hidden], .dl-end[hidden], .dl-start[hidden], .dl-choice[hidden] { display: none; }
  .dl-profile { display: flex; align-items: center; gap: 14px; }
  .dl-face {
    display: grid;
    place-items: center;
    flex: none;
    width: 64px;
    height: 64px;
    border-radius: 18px;
    background: var(--accent-soft);
