---
import Base from '../../layouts/Base.astro';
---

<Base
  title="과일 합치기"
  description="같은 과일끼리 부딪혀 더 큰 과일로 키우는 물리 퍼즐 게임"
  heading="과일 합치기"
  tagline="같은 과일이 닿으면 한 단계 큰 과일이 돼요 · 목표는 수박 🍉"
>
  <div class="fm-wrap">
    <div class="fm-bar">
      <div class="fm-score"><span>점수</span><strong id="fm-score">0</strong></div>
      <div class="fm-score"><span>최고</span><strong id="fm-best">0</strong></div>
      <div class="fm-score"><span>다음</span><strong id="fm-next" class="fm-emoji">🍒</strong></div>
      <button id="fm-new" class="tool-btn" type="button">새 게임</button>
    </div>
    <div class="fm-stage">
      <canvas id="fm-canvas" aria-label="과일 합치기 게임판. 좌우로 움직여 위치를 고르고 눌러서 떨어뜨려요" role="img"></canvas>
      <div id="fm-over" class="fm-over" hidden>
        <p id="fm-over-title">과일이 넘쳤어요!</p>
        <button id="fm-retry" class="tool-btn tool-btn-primary" type="button">다시 하기</button>
      </div>
    </div>
    <ol class="fm-chain" aria-label="과일 순서">
      <li>🍒</li><li>🍓</li><li>🍇</li><li>🍊</li><li>🍋</li><li>🍎</li><li>🍐</li><li>🍑</li><li>🍍</li><li>🍈</li><li>🍉</li>
    </ol>
    <p class="tool-hint">마우스·손가락으로 위치를 고르고 눌러서 떨어뜨려요 · 키보드: ←→ 이동, 스페이스 떨어뜨리기</p>
  </div>
</Base>

<script>
  import Matter from 'matter-js';

  const { Engine, Bodies, Composite, Events, Body } = Matter;

  // 작은 것부터 큰 것 순서. 같은 단계 두 개가 닿으면 다음 단계가 된다.
  const FRUITS = [
    { e: '🍒', r: 14, c: '#d6304a' },
    { e: '🍓', r: 19, c: '#f0535a' },
    { e: '🍇', r: 26, c: '#8e5bd1' },
    { e: '🍊', r: 31, c: '#f59a23' },
    { e: '🍋', r: 38, c: '#f2cf3a' },
    { e: '🍎', r: 46, c: '#e0453a' },
    { e: '🍐', r: 54, c: '#b9cf4a' },
    { e: '🍑', r: 62, c: '#f6a38a' },
    { e: '🍍', r: 72, c: '#e8b23a' },
    { e: '🍈', r: 84, c: '#9fd07a' },
    { e: '🍉', r: 98, c: '#3f9b4f' },
  ];
  const POINTS = FRUITS.map((_, i) => ((i + 1) * (i + 2)) / 2); // 1, 3, 6, 10, ...
  const W = 400;
  const H = 600;
  const WALL = 20;
  const TOP = 92; // 이 선 위로 과일이 2초 넘게 머물면 끝
  const DROP_Y = 46;
  const BEST_KEY = 'game:fruit-merge:best';

  type Fruit = Matter.Body & { level: number; born: number; overSince: number; merging?: boolean };

  const canvas = document.getElementById('fm-canvas') as HTMLCanvasElement;
  const ctx = canvas.getContext('2d')!;
  const scoreEl = document.getElementById('fm-score')!;
  const bestEl = document.getElementById('fm-best')!;
  const nextEl = document.getElementById('fm-next')!;
  const overEl = document.getElementById('fm-over')!;
  const overTitle = document.getElementById('fm-over-title')!;

  const engine = Engine.create({ gravity: { x: 0, y: 1 } });
  const wallOpts = { isStatic: true, friction: 0.3, restitution: 0.1 };
  Composite.add(engine.world, [
    Bodies.rectangle(W / 2, H + WALL / 2 - 4, W, WALL, wallOpts),
    Bodies.rectangle(-WALL / 2 + 4, H / 2, WALL, H * 2, wallOpts),
    Bodies.rectangle(W + WALL / 2 - 4, H / 2, WALL, H * 2, wallOpts),
  ]);

  let fruits: Fruit[] = [];
  let score = 0;
  let best = 0;
  let aimX = W / 2;
  let current = 0;
  let next = 0;
  let canDrop = true;
  let over = false;
  let scale = 1;
  const pops: { x: number; y: number; r: number; t: number; c: string }[] = [];

  try {
    best = Number(localStorage.getItem(BEST_KEY)) || 0;
  } catch {}
  bestEl.textContent = String(best);

  // 처음엔 작은 과일 위주로
  const randomLevel = () => [0, 0, 1, 1, 2, 2, 3, 4][Math.floor(Math.random() * 8)];

  function makeFruit(level: number, x: number, y: number) {
    const f = Bodies.circle(x, y, FRUITS[level].r, { restitution: 0.15, friction: 0.08, density: 0.0012 }) as Fruit;
    f.level = level;
    f.born = performance.now();
    f.overSince = 0;
    fruits.push(f);
    Composite.add(engine.world, f);
    return f;
  }

  function setScore(v: number) {
    score = v;
    scoreEl.textContent = String(score);
    if (score > best) {
      best = score;
      bestEl.textContent = String(best);
      try {
        localStorage.setItem(BEST_KEY, String(best));
      } catch {}
    }
  }

  function newGame() {
    for (const f of fruits) Composite.remove(engine.world, f);
    fruits = [];
    pops.length = 0;
    setScore(0);
    current = randomLevel();
    next = randomLevel();
    nextEl.textContent = FRUITS[next].e;
    canDrop = true;
    over = false;
    overEl.hidden = true;
  }

  function clampAim(x: number) {
    const r = FRUITS[current].r;
    return Math.max(r + 2, Math.min(W - r - 2, x));
  }

  function drop() {
    if (!canDrop || over) return;
    makeFruit(current, clampAim(aimX), DROP_Y);
    current = next;
    next = randomLevel();
    nextEl.textContent = FRUITS[next].e;
    canDrop = false;
    setTimeout(() => (canDrop = true), 450);
  }

  // 같은 단계끼리 닿으면 합친다 (물리 계산 중에 바로 지우지 않고 모아 두었다가 처리)
  const toMerge: [Fruit, Fruit][] = [];
  Events.on(engine, 'collisionStart', (ev) => {
    for (const { bodyA, bodyB } of ev.pairs) {
      const a = bodyA as Fruit;
      const b = bodyB as Fruit;
      if (a.level === undefined || b.level === undefined || a.level !== b.level || a.merging || b.merging) continue;
      a.merging = b.merging = true;
      toMerge.push([a, b]);
    }
  });

  function processMerges() {
    while (toMerge.length) {
      const [a, b] = toMerge.pop()!;
      Composite.remove(engine.world, [a, b]);
      fruits = fruits.filter((f) => f !== a && f !== b);
      const x = (a.position.x + b.position.x) / 2;
      const y = (a.position.y + b.position.y) / 2;
      const lv = a.level + 1;
      if (lv < FRUITS.length) {
        const f = makeFruit(lv, x, y);
        Body.setVelocity(f, { x: (a.velocity.x + b.velocity.x) / 2, y: Math.min(a.velocity.y, b.velocity.y) });
        setScore(score + POINTS[lv]);
        pops.push({ x, y, r: FRUITS[lv].r, t: performance.now(), c: FRUITS[lv].c });
      } else {
        setScore(score + 100); // 수박 두 개 → 사라지며 보너스
        pops.push({ x, y, r: 110, t: performance.now(), c: FRUITS[10].c });
      }
    }
  }

  function checkOver(now: number) {
    for (const f of fruits) {
      const above = f.position.y - FRUITS[f.level].r < TOP && now - f.born > 1200;
      if (above) {
        f.overSince ||= now;
        if (now - f.overSince > 2000) {
          over = true;
          overTitle.textContent = `과일이 넘쳤어요! · ${score}점`;
          overEl.hidden = false;
          return;
        }
      } else f.overSince = 0;
    }
  }

  function resize() {
    const dpr = window.devicePixelRatio || 1;
    scale = canvas.clientWidth / W;
    canvas.width = Math.round(canvas.clientWidth * dpr);
    canvas.height = Math.round(canvas.clientWidth * (H / W) * dpr);
    ctx.setTransform(dpr * scale, 0, 0, dpr * scale, 0, 0);
  }
  new ResizeObserver(resize).observe(canvas);

  function drawFruit(level: number, x: number, y: number, angle = 0, alpha = 1) {
    const { e, r, c } = FRUITS[level];
    ctx.save();
    ctx.globalAlpha = alpha;
    ctx.translate(x, y);
    ctx.rotate(angle);
    ctx.fillStyle = c;
    ctx.beginPath();
    ctx.arc(0, 0, r, 0, Math.PI * 2);
    ctx.fill();
    ctx.fillStyle = 'rgb(255 255 255 / 30%)';
    ctx.beginPath();
    ctx.arc(-r * 0.35, -r * 0.35, r * 0.28, 0, Math.PI * 2);
    ctx.fill();
    ctx.font = `${Math.round(r * 1.35)}px "Apple Color Emoji","Segoe UI Emoji","Noto Color Emoji",sans-serif`;
    ctx.textAlign = 'center';
    ctx.textBaseline = 'middle';
    ctx.fillText(e, 0, r * 0.08);
    ctx.restore();
  }

  function draw(now: number) {
    const dark = document.documentElement.dataset.theme === 'dark';
    ctx.clearRect(0, 0, W, H);
    ctx.fillStyle = dark ? '#2a221d' : '#fff6e8';
    ctx.fillRect(0, 0, W, H);
    // 위험선
    const danger = fruits.some((f) => f.overSince);
    ctx.strokeStyle = danger ? '#d6304a' : dark ? '#5c4a3c' : '#e8cfae';
    ctx.lineWidth = 2;
    ctx.setLineDash([8, 6]);
    ctx.beginPath();
    ctx.moveTo(0, TOP);
    ctx.lineTo(W, TOP);
    ctx.stroke();
    ctx.setLineDash([]);
    // 조준선과 들고 있는 과일
    if (!over) {
      const x = clampAim(aimX);
      ctx.strokeStyle = dark ? 'rgb(255 255 255 / 12%)' : 'rgb(120 80 40 / 14%)';
      ctx.lineWidth = 2;
      ctx.beginPath();
      ctx.moveTo(x, DROP_Y);
      ctx.lineTo(x, H);
      ctx.stroke();
      drawFruit(current, x, DROP_Y, 0, canDrop ? 1 : 0.45);
    }
    for (const f of fruits) drawFruit(f.level, f.position.x, f.position.y, f.angle);
    // 합쳐질 때 퍼지는 고리
    for (let i = pops.length - 1; i >= 0; i--) {
      const p = pops[i];
      const k = (now - p.t) / 350;
      if (k >= 1) {
        pops.splice(i, 1);
        continue;
      }
      ctx.strokeStyle = p.c;
      ctx.globalAlpha = 1 - k;
      ctx.lineWidth = 4;
      ctx.beginPath();
      ctx.arc(p.x, p.y, p.r * (1 + k * 0.5), 0, Math.PI * 2);
      ctx.stroke();
      ctx.globalAlpha = 1;
    }
  }

  let last = performance.now();
  let acc = 0;
  const STEP = 1000 / 60;
  function loop(now: number) {
    acc += Math.min(100, now - last);
    last = now;
    while (acc >= STEP) {
      if (!over) {
        Engine.update(engine, STEP);
        processMerges();
      }
      acc -= STEP;
    }
    if (!over) checkOver(now);
    draw(now);
    requestAnimationFrame(loop);
  }

  const toWorldX = (clientX: number) => (clientX - canvas.getBoundingClientRect().left) / scale;
  canvas.addEventListener('pointermove', (e) => (aimX = toWorldX(e.clientX)));
  canvas.addEventListener('pointerdown', (e) => {
    aimX = toWorldX(e.clientX);
    if (e.pointerType === 'mouse') drop();
  });
  // 터치는 손가락으로 위치를 맞춘 뒤 뗄 때 떨어뜨린다
  canvas.addEventListener('pointerup', (e) => {
    if (e.pointerType !== 'mouse') drop();
  });
  window.addEventListener('keydown', (e) => {
    const el = e.target instanceof Element ? e.target : null;
    if (el?.closest('input, textarea, select, dialog, button')) return;
    if (e.code === 'ArrowLeft' || e.code === 'ArrowRight') {
      e.preventDefault();
      aimX = clampAim(aimX) + (e.code === 'ArrowLeft' ? -14 : 14);
    } else if (e.code === 'Space' || e.code === 'Enter') {
      e.preventDefault();
      if (!e.repeat) drop();
    }
  });
  document.getElementById('fm-new')!.addEventListener('click', newGame);
  document.getElementById('fm-retry')!.addEventListener('click', newGame);

  resize();
  newGame();
  requestAnimationFrame(loop);
</script>

<style>
  .fm-wrap { max-width: 440px; margin: 0 auto; }
  .fm-bar { display: flex; align-items: stretch; gap: 8px; margin-bottom: 12px; }
  .fm-score {
    display: flex; flex-direction: column; align-items: center; justify-content: center; min-width: 70px;
    background: var(--surface-1); border: 1px solid var(--hairline); border-radius: 10px; padding: 4px 10px;
  }
  .fm-score span { font-size: 0.72rem; color: var(--text-muted); }
  .fm-score strong { font-size: 1.15rem; font-variant-numeric: tabular-nums; }
  .fm-emoji { font-size: 1.3rem !important; line-height: 1.2; }
  .fm-bar .tool-btn { margin-left: auto; }
  .fm-stage { position: relative; }
  #fm-canvas {
    display: block; width: 100%; aspect-ratio: 2 / 3; border-radius: 14px;
    border: 3px solid #e8cfae; touch-action: none; cursor: crosshair;
  }
  :global([data-theme='dark']) #fm-canvas { border-color: #5c4a3c; }
  .fm-over {
    position: absolute; inset: 0; border-radius: 14px;
    display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 12px;
    background: color-mix(in srgb, var(--plane) 75%, transparent); backdrop-filter: blur(2px);
  }
  .fm-over[hidden] { display: none; }
  .fm-over p { margin: 0; font-size: 1.2rem; font-weight: 700; }
  .fm-chain { display: flex; justify-content: center; flex-wrap: wrap; gap: 2px; list-style: none; padding: 0; margin: 12px 0 0; font-size: 1.25rem; }
  .fm-chain li:not(:last-child)::after { content: '›'; margin: 0 2px; color: var(--text-muted); font-size: 0.9rem; }
</style>
