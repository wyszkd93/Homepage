---
import { getImage } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import moguFace from '../../assets/mogu-face.webp';

const face = await getImage({ src: moguFace, width: 128, format: 'webp' });
---

<Base
  title="모구 점프"
  description="모구가 버그와 락을 뛰어넘으며 달리는 미니게임"
  heading="모구 점프"
  tagline="버그·락·ORA 에러를 피해 최대한 멀리! · 스페이스, ↑, 클릭이나 터치로 점프"
>
  <div class="tool-panel jump-panel">
    <div class="jump-hud tool-mono">
      <span>점수 <strong id="mj-score">0</strong></span>
      <span>최고 <strong id="mj-best">0</strong></span>
    </div>
    <canvas id="mj-canvas" data-face={face.src} aria-label="모구 점프 게임 화면" role="img"></canvas>
    <p class="tool-hint">길게 누르면 더 높이 뛰어요. 달릴수록 점점 빨라집니다.</p>
  </div>
</Base>

<script>
  type Obstacle = { kind: 'bug' | 'lock' | 'ora'; x: number; w: number; h: number };

  const canvas = document.getElementById('mj-canvas') as HTMLCanvasElement;
  const ctx = canvas.getContext('2d')!;
  const scoreEl = document.getElementById('mj-score')!;
  const bestEl = document.getElementById('mj-best')!;
  const face = new Image();
  face.src = canvas.dataset.face!;

  const H = 260;
  const GROUND = H - 34;
  const R = 22; // 모구 반지름
  const PX = 70; // 모구 x
  const GRAVITY = 2400;
  const JUMP_V = -820;
  const CUT_V = -360; // 일찍 떼면 이 속도로 끊어 낮게 뜀
  const BEST_KEY = 'game:mogu-jump:best';

  let W = 600;
  let state: 'ready' | 'run' | 'pause' | 'over' = 'ready';
  let y = GROUND - R;
  let vy = 0;
  let speed = 0;
  let dist = 0;
  let obstacles: Obstacle[] = [];
  let nextGap = 0;
  let last = 0;
  let pressing = false;
  let best = 0;
  let colors = readColors();

  try {
    best = Number(localStorage.getItem(BEST_KEY)) || 0;
  } catch {}
  bestEl.textContent = String(best);

  function readColors() {
    const cs = getComputedStyle(document.documentElement);
    const v = (n: string) => cs.getPropertyValue(n).trim();
    return { ink: v('--ink'), muted: v('--text-muted'), line: v('--hairline'), soft: v('--gridline'), bg: v('--surface-2') };
  }
  new MutationObserver(() => {
    colors = readColors();
    if (state !== 'run') draw();
  }).observe(document.documentElement, { attributes: true, attributeFilter: ['data-theme'] });

  function resize() {
    const dpr = window.devicePixelRatio || 1;
    W = Math.max(280, canvas.clientWidth);
    canvas.width = Math.round(W * dpr);
    canvas.height = Math.round(H * dpr);
    ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
    if (state !== 'run') draw();
  }
  new ResizeObserver(resize).observe(canvas);

  function reset() {
    y = GROUND - R;
    vy = 0;
    speed = 330;
    dist = 0;
    obstacles = [];
    nextGap = 260;
  }

  function spawn() {
    const roll = Math.random();
    const o: Obstacle =
      roll < 0.45 ? { kind: 'bug', x: W + 20, w: 34, h: 24 }
      : roll < 0.8 ? { kind: 'lock', x: W + 20, w: 28, h: 38 }
      : { kind: 'ora', x: W + 20, w: 78, h: 26 };
    obstacles.push(o);
    // 체공 거리(속도 × 체공시간)보다 넉넉한 간격
    nextGap = speed * 0.75 + o.w + 140 + Math.random() * 320;
  }

  function hit(o: Obstacle) {
    const r = R - 5;
    const top = GROUND - o.h + 3;
    const cx = Math.max(o.x + 3, Math.min(PX, o.x + o.w - 3));
    const cy = Math.max(top, Math.min(y, GROUND));
    return (PX - cx) ** 2 + (y - cy) ** 2 < r * r;
  }

  function update(dt: number) {
    speed = Math.min(900, speed + 11 * dt);
    dist += speed * dt;
    vy += GRAVITY * dt;
    y += vy * dt;
    if (y > GROUND - R) {
      y = GROUND - R;
      vy = 0;
    }
    for (const o of obstacles) o.x -= speed * dt;
    obstacles = obstacles.filter((o) => o.x + o.w > -10);
    nextGap -= speed * dt;
    if (nextGap <= 0) spawn();
    if (obstacles.some(hit)) gameOver();
    scoreEl.textContent = String(score());
  }

  const score = () => Math.floor(dist / 10);

  function gameOver() {
    state = 'over';
    const s = score();
    if (s > best) {
      best = s;
      bestEl.textContent = String(best);
      try {
        localStorage.setItem(BEST_KEY, String(best));
      } catch {}
    }
  }

  function drawBug(o: Obstacle) {
    const cx = o.x + o.w / 2;
    const cy = GROUND - o.h / 2 - 2;
    ctx.strokeStyle = '#7a2a2f';
    ctx.lineWidth = 2;
    for (const dx of [-8, 0, 8]) {
      ctx.beginPath();
      ctx.moveTo(cx + dx, cy);
      ctx.lineTo(cx + dx - 4, GROUND);
      ctx.moveTo(cx + dx, cy);
      ctx.lineTo(cx + dx + 4, GROUND);
      ctx.stroke();
    }
    ctx.fillStyle = '#c2414b';
    ctx.beginPath();
    ctx.ellipse(cx, cy, o.w / 2, o.h / 2 - 2, 0, 0, Math.PI * 2);
    ctx.fill();
    ctx.fillStyle = '#7a2a2f';
    ctx.fillRect(cx - 1, cy - o.h / 2 + 3, 2, o.h - 6);
    ctx.beginPath();
    ctx.arc(cx + o.w / 2 - 2, cy - 2, 5, 0, Math.PI * 2);
    ctx.fill();
  }

  function drawLock(o: Obstacle) {
    const bodyH = o.h * 0.6;
    ctx.strokeStyle = '#8a8f98';
    ctx.lineWidth = 4;
    ctx.beginPath();
    ctx.arc(o.x + o.w / 2, GROUND - bodyH, o.w / 2 - 5, Math.PI, 0);
    ctx.stroke();
    ctx.fillStyle = '#e0a526';
    ctx.beginPath();
    ctx.roundRect(o.x, GROUND - bodyH, o.w, bodyH, 4);
    ctx.fill();
    ctx.fillStyle = '#6b4d10';
    ctx.beginPath();
    ctx.arc(o.x + o.w / 2, GROUND - bodyH / 2 - 2, 3, 0, Math.PI * 2);
    ctx.fill();
  }

  function drawOra(o: Obstacle) {
    ctx.fillStyle = '#c2414b';
    ctx.beginPath();
    ctx.roundRect(o.x, GROUND - o.h, o.w, o.h, 5);
    ctx.fill();
    ctx.fillStyle = '#fff';
    ctx.font = '700 12px ui-monospace, Menlo, Consolas, monospace';
    ctx.textAlign = 'center';
    ctx.textBaseline = 'middle';
    ctx.fillText('ORA-600', o.x + o.w / 2, GROUND - o.h / 2 + 1);
  }

  function drawMogu() {
    ctx.save();
    ctx.beginPath();
    ctx.arc(PX, y, R, 0, Math.PI * 2);
    ctx.closePath();
    ctx.fillStyle = '#f4c08a';
    ctx.fill();
    ctx.clip();
    if (face.complete && face.naturalWidth) ctx.drawImage(face, PX - R, y - R, R * 2, R * 2);
    ctx.restore();
    ctx.strokeStyle = '#c0632f';
    ctx.lineWidth = 2;
    ctx.beginPath();
    ctx.arc(PX, y, R, 0, Math.PI * 2);
    ctx.stroke();
  }

  const WORDS = ['SELECT', 'COMMIT', 'ROLLBACK', 'INDEX', 'REDO', 'UNDO', 'ASM', 'RAC'];

  function draw() {
    ctx.clearRect(0, 0, W, H);
    ctx.fillStyle = colors.bg;
    ctx.fillRect(0, 0, W, H);
    // 배경 단어 (느린 시차)
    ctx.font = '600 13px ui-monospace, Menlo, Consolas, monospace';
    ctx.textAlign = 'left';
    ctx.textBaseline = 'alphabetic';
    ctx.fillStyle = colors.soft;
    const span = 190;
    const off = (dist * 0.2) % span;
    for (let i = -1; i < W / span + 2; i++) {
      const n = WORDS.length;
      const w = WORDS[(((i + Math.floor((dist * 0.2) / span)) % n) + n) % n];
      ctx.fillText(w, i * span - off, 50 + ((i * 37) % 3) * 30);
    }
    // 바닥
    ctx.strokeStyle = colors.line;
    ctx.lineWidth = 2;
    ctx.beginPath();
    ctx.moveTo(0, GROUND + 1);
    ctx.lineTo(W, GROUND + 1);
    ctx.stroke();
    ctx.fillStyle = colors.line;
    const doff = dist % 40;
    for (let x = -doff; x < W; x += 40) ctx.fillRect(x, GROUND + 10, 14, 2);

    for (const o of obstacles) (o.kind === 'bug' ? drawBug : o.kind === 'lock' ? drawLock : drawOra)(o);
    drawMogu();

    if (state !== 'run') {
      ctx.fillStyle = colors.ink;
      ctx.textAlign = 'center';
      ctx.font = '700 20px Pretendard, system-ui, sans-serif';
      const title = state === 'ready' ? '모구 점프' : state === 'pause' ? '일시정지' : '앗, 장애 발생!';
      ctx.fillText(title, W / 2, 96);
      ctx.font = '500 14px Pretendard, system-ui, sans-serif';
      ctx.fillStyle = colors.muted;
      const sub =
        state === 'ready' ? '스페이스 · 클릭 · 터치로 시작'
        : state === 'pause' ? '스페이스 · 클릭 · 터치로 이어 하기'
        : `점수 ${score()} · 다시 하려면 스페이스 · 클릭 · 터치`;
      ctx.fillText(sub, W / 2, 124);
    }
  }

  function loop(t: number) {
    if (state !== 'run') return;
    const dt = Math.min(1 / 30, (t - last) / 1000 || 0);
    last = t;
    update(dt);
    draw();
    requestAnimationFrame(loop);
  }

  function press() {
    pressing = true;
    if (state !== 'run') {
      if (state !== 'pause') reset();
      state = 'run';
      last = performance.now();
      requestAnimationFrame(loop);
    }
    if (y >= GROUND - R - 0.5) vy = JUMP_V;
  }
  function release() {
    if (pressing && vy < CUT_V) vy = CUT_V;
    pressing = false;
  }

  const JUMP_KEYS = ['Space', 'ArrowUp', 'KeyW'];
  window.addEventListener('keydown', (e) => {
    if (!JUMP_KEYS.includes(e.code)) return;
    const el = e.target instanceof Element ? e.target : null;
    if (el?.closest('input, textarea, select, dialog')) return;
    e.preventDefault();
    if (!e.repeat) press();
  });
  window.addEventListener('keyup', (e) => JUMP_KEYS.includes(e.code) && release());
  canvas.addEventListener('pointerdown', (e) => {
    e.preventDefault();
    press();
  });
  window.addEventListener('pointerup', release);
  document.addEventListener('visibilitychange', () => {
    if (document.hidden && state === 'run') {
      state = 'pause';
      draw();
    }
  });
  face.addEventListener('load', () => state !== 'run' && draw());
  reset();
  speed = 0;
  resize();
</script>

<style>
  .jump-panel { padding: 14px; }
  .jump-hud { display: flex; justify-content: flex-end; gap: 18px; font-size: 0.9rem; color: var(--text-muted); margin: 0 4px 8px; }
  .jump-hud strong { color: var(--ink); font-variant-numeric: tabular-nums; }
  #mj-canvas { display: block; width: 100%; height: 260px; border-radius: 10px; touch-action: manipulation; cursor: pointer; }
</style>
