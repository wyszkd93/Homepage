---
import Base from '../../layouts/Base.astro';

const PRESETS: [string, string, string][] = [
  ['이메일', '^[[:alnum:]._%+-]+@[[:alnum:].-]+\\.[[:alpha:]]{2,}$', 'like'],
  ['휴대폰 번호', '01[016789]-?[0-9]{3,4}-?[0-9]{4}', 'substr'],
  ['숫자만 뽑기', '[0-9]+', 'substr'],
  ['날짜 YYYY-MM-DD', '([0-9]{4})-([0-9]{2})-([0-9]{2})', 'replace'],
  ['IPv4', '([0-9]{1,3}\\.){3}[0-9]{1,3}', 'substr'],
  ['ORA 에러 번호', 'ORA-[0-9]{5}', 'count'],
  ['한글만', '[가-힣]+', 'substr'],
  ['연속 공백 하나로', ' {2,}', 'replace'],
];
---

<Base
  title="정규식 테스터 (Oracle)"
  description="Oracle REGEXP_LIKE·REGEXP_SUBSTR·REGEXP_REPLACE·REGEXP_COUNT·REGEXP_INSTR 결과를 미리 확인하고 SQL로 복사하는 도구"
  heading="정규식 테스터"
  tagline="Oracle REGEXP_* 결과를 미리 보고 SQL로 복사해요"
>
  <div class="tool-panel">
    <div class="rx-fns" role="tablist" aria-label="함수">
      <button class="rx-fn" data-fn="like" type="button" role="tab">REGEXP_LIKE</button>
      <button class="rx-fn" data-fn="substr" type="button" role="tab" aria-selected="true">REGEXP_SUBSTR</button>
      <button class="rx-fn" data-fn="replace" type="button" role="tab">REGEXP_REPLACE</button>
      <button class="rx-fn" data-fn="count" type="button" role="tab">REGEXP_COUNT</button>
      <button class="rx-fn" data-fn="instr" type="button" role="tab">REGEXP_INSTR</button>
    </div>

    <label class="rx-label" for="rx-pat">패턴</label>
    <input id="rx-pat" class="tool-input tool-mono rx-pat" value="01[016789]-?[0-9]{3,4}-?[0-9]{4}" spellcheck="false" autocomplete="off" />

    <div class="rx-opts">
      <label>시작 위치 <input id="rx-pos" class="tool-input tool-mono" type="number" min="1" value="1" /></label>
      <label data-for="substr instr replace">몇 번째 <input id="rx-occ" class="tool-input tool-mono" type="number" min="0" value="1" /></label>
      <label data-for="substr instr">그룹 번호 <input id="rx-sub" class="tool-input tool-mono" type="number" min="0" max="9" value="0" /></label>
      <label data-for="instr">반환 <select id="rx-ret" class="tool-select"><option value="0">시작 위치</option><option value="1">끝 다음 위치</option></select></label>
      <label class="rx-wide" data-for="replace">바꿀 문자열 <span class="rx-sub">(\1 ~ \9 로 그룹)</span><input id="rx-rep" class="tool-input tool-mono" value="" spellcheck="false" /></label>
    </div>
    <div class="rx-flags" aria-label="match_parameter">
      <span class="rx-sub">match_parameter</span>
      <label title="대소문자 무시"><input type="checkbox" data-flag="i" /> i 대소문자 무시</label>
      <label title="점(.)이 줄바꿈도 포함"><input type="checkbox" data-flag="n" /> n 점이 줄바꿈 포함</label>
      <label title="^ $ 가 줄마다"><input type="checkbox" data-flag="m" /> m 여러 줄</label>
      <label title="패턴 안 공백 무시"><input type="checkbox" data-flag="x" /> x 공백 무시</label>
    </div>
    <div class="chips rx-presets">
      {PRESETS.map(([label, pat, fn]) => (
        <button class="chip chip-link rx-preset" type="button" data-pat={pat} data-fn={fn}>{label}</button>
      ))}
    </div>
  </div>

  <div class="tool-panel">
    <label class="rx-label" for="rx-text">테스트할 값 <span class="rx-sub">(한 줄 = 한 행)</span></label>
    <textarea id="rx-text" class="tool-textarea tool-mono rx-text" spellcheck="false">고객센터 010-1234-5678 로 연락
담당자 01098765432 (내선 123)
연락처 없음
2026-11-04 배치 실패: ORA-01555, ORA-00060
admin@example.com</textarea>
    <p id="rx-msg" class="tool-msg"></p>
  </div>

  <div class="tool-panel">
    <h2>결과</h2>
    <ol id="rx-out" class="rx-out"></ol>
    <div class="rx-sql">
      <code id="rx-sql" class="tool-mono"></code>
      <button id="rx-copy" class="tool-btn" type="button">SQL 복사</button>
    </div>
    <p class="tool-hint">브라우저 정규식으로 Oracle 동작을 흉내 낸 결과예요. 대부분 같지만, 문자셋·로케일(NLS)에 따라 [[:alpha:]] 같은 범위는 실제 DB와 다를 수 있어요.</p>
  </div>
</Base>

<script>
  import { run, sqlOf, type Fn, type Opts } from '../../utils/oregex';

  const $ = <T extends HTMLElement>(id: string) => document.getElementById(id) as T;
  const num = (id: string, d: number) => { const v = parseInt(($(id) as HTMLInputElement).value, 10); return Number.isFinite(v) ? v : d; };
  let fn: Fn = 'substr';
  const msg = $('rx-msg');

  function setFn(f: Fn) {
    fn = f;
    for (const b of document.querySelectorAll<HTMLButtonElement>('.rx-fn')) b.setAttribute('aria-selected', String(b.dataset.fn === f));
    for (const l of document.querySelectorAll<HTMLElement>('[data-for]')) l.hidden = !l.dataset.for!.split(' ').includes(f);
    const occ = $('rx-occ') as HTMLInputElement;
    occ.min = f === 'replace' ? '0' : '1';
    if (f !== 'replace' && +occ.value < 1) occ.value = '1';
    render();
  }

  function opts(): Opts {
    const match = [...document.querySelectorAll<HTMLInputElement>('[data-flag]')].filter((c) => c.checked).map((c) => c.dataset.flag).join('');
    return {
      pattern: ($('rx-pat') as HTMLInputElement).value,
      match,
      position: Math.max(1, num('rx-pos', 1)),
      occurrence: Math.max(fn === 'replace' ? 0 : 1, num('rx-occ', 1)),
      subexpr: Math.min(9, Math.max(0, num('rx-sub', 0))),
      replace: ($('rx-rep') as HTMLInputElement).value,
      returnOpt: (+($('rx-ret') as HTMLSelectElement).value as 0 | 1),
    };
  }

  function render() {
    const o = opts();
    const out = $('rx-out');
    out.innerHTML = '';
    msg.textContent = '';
    msg.classList.remove('is-error');
    $('rx-sql').textContent = o.pattern ? `SELECT ${fn === 'like' ? 'col FROM 테이블 ' : ''}${sqlOf(fn, o)}${fn === 'like' ? '' : ' AS result FROM 테이블'};` : '';
    if (!o.pattern) { msg.textContent = '패턴을 입력하세요.'; return; }
    const rows = ($('rx-text') as HTMLTextAreaElement).value.split('\n');
    const warns = new Set<string>();
    try {
      rows.forEach((src, i) => {
        const r = run(fn, src, o);
        r.warnings.forEach((w) => warns.add(w));
        const li = document.createElement('li');
        li.className = 'rx-row';
        const line = document.createElement('div');
        line.className = 'rx-line tool-mono';
        let last = 0;
        for (const h of r.hits) {
          if (h.start < last) continue;
          line.append(src.slice(last, h.start));
          const mark = document.createElement('mark');
          mark.textContent = src.slice(h.start, h.end) || '∅';
          line.append(mark);
          last = h.end;
        }
        line.append(src.slice(last));
        if (!src) line.textContent = '(빈 줄 = NULL)';
        const res = document.createElement('div');
        res.className = 'rx-res tool-mono' + (/^(NULL|FALSE|0)$/.test(r.value) ? ' is-empty' : '');
        res.textContent = `→ ${r.value}`;
        li.append(line, res);
        li.dataset.n = String(i + 1);
        out.append(li);
      });
      if (warns.size) { msg.textContent = [...warns].join(' '); msg.classList.add('is-error'); }
    } catch (e) {
      msg.textContent = `패턴 오류: ${(e as Error).message.replace(/^Invalid regular expression: /, '')}`;
      msg.classList.add('is-error');
    }
  }

  for (const b of document.querySelectorAll<HTMLButtonElement>('.rx-fn')) b.addEventListener('click', () => setFn(b.dataset.fn as Fn));
  for (const b of document.querySelectorAll<HTMLButtonElement>('.rx-preset')) {
    b.addEventListener('click', () => {
      ($('rx-pat') as HTMLInputElement).value = b.dataset.pat!;
      if (b.dataset.pat === '([0-9]{4})-([0-9]{2})-([0-9]{2})') ($('rx-rep') as HTMLInputElement).value = '\\3/\\2/\\1';
      if (b.dataset.pat === ' {2,}') ($('rx-rep') as HTMLInputElement).value = ' ';
      ($('rx-occ') as HTMLInputElement).value = b.dataset.fn === 'replace' ? '0' : '1';
      setFn(b.dataset.fn as Fn);
    });
  }
  for (const el of document.querySelectorAll<HTMLElement>('#rx-pat, #rx-text, #rx-pos, #rx-occ, #rx-sub, #rx-ret, #rx-rep, [data-flag]')) {
    el.addEventListener('input', render);
    el.addEventListener('change', render);
  }
  $('rx-copy').addEventListener('click', async () => {
    try {
      await navigator.clipboard.writeText($('rx-sql').textContent ?? '');
      $('rx-copy').textContent = '복사됨';
      setTimeout(() => ($('rx-copy').textContent = 'SQL 복사'), 1200);
    } catch {
      msg.textContent = '복사하지 못했어요. 직접 선택해 복사해 주세요.';
    }
  });
  setFn('substr');
</script>

<style is:global>
  /* 스크립트가 만드는 요소에도 적용되도록 전역 스타일 (클래스 이름 앞에 xp-/rx-를 붙여 겹치지 않게) */
  .rx-fns { display: flex; flex-wrap: wrap; gap: 6px; margin-bottom: 14px; }
  .rx-fn { padding: 6px 12px; border-radius: 999px; border: 1px solid var(--hairline); background: var(--surface-1); color: var(--ink-muted); font: 600 0.8rem/1.2 ui-monospace, SFMono-Regular, Menlo, Consolas, monospace; cursor: pointer; }
  .rx-fn[aria-selected='true'] { background: var(--accent); border-color: var(--accent); color: #fff; }
  :root[data-theme='dark'] .rx-fn[aria-selected='true'] { color: #181412; }
  .rx-label { display: block; font-size: 0.86rem; color: var(--ink-muted); margin-bottom: 5px; }
  .rx-pat { width: 100%; font-size: 1rem; }
  .rx-sub { color: var(--text-muted); font-size: 0.78rem; }
  .rx-opts { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 10px 12px; margin-top: 12px; }
  .rx-opts label { display: grid; gap: 4px; font-size: 0.82rem; color: var(--ink-muted); }
  .rx-opts label[hidden] { display: none; }
  .rx-opts .tool-input, .rx-opts .tool-select { width: 100%; min-width: 0; box-sizing: border-box; }
  .rx-opts .rx-wide { grid-column: span 2; }
  .rx-flags { display: flex; flex-wrap: wrap; gap: 6px 14px; align-items: center; margin-top: 12px; font-size: 0.85rem; }
  .rx-flags label { display: inline-flex; gap: 5px; align-items: center; }
  .rx-presets { margin-top: 12px; }
  .rx-text { min-height: 130px; }
  .rx-out { list-style: none; margin: 0; padding: 0; display: grid; gap: 6px; }
  .rx-row { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 0.7fr); gap: 4px 14px; padding: 8px 10px; border-radius: 10px; background: var(--surface-2); align-items: baseline; }
  .rx-line { font-size: 0.85rem; overflow-wrap: anywhere; white-space: pre-wrap; }
  .rx-line mark { background: color-mix(in srgb, var(--accent) 28%, transparent); color: inherit; border-radius: 3px; padding: 0 1px; }
  .rx-res { font-size: 0.85rem; font-weight: 700; overflow-wrap: anywhere; white-space: pre-wrap; }
  .rx-res.is-empty { color: var(--text-muted); font-weight: 500; }
  .rx-sql { display: flex; gap: 8px; align-items: center; margin-top: 14px; }
  .rx-sql code { flex: 1; min-width: 0; overflow-x: auto; white-space: nowrap; padding: 7px 10px; border-radius: 8px; background: var(--surface-2); font-size: 0.82rem; }
  @media (max-width: 640px) {
    .rx-opts { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); }
    .rx-row { grid-template-columns: minmax(0, 1fr); }
  }
</style>
