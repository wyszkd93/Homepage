---
import Base from '../../layouts/Base.astro';
---

<Base
  title="에포크·시간 변환기"
  description="Unix 에포크(타임스탬프)와 날짜를 UTC·KST로 서로 바꾸고 Oracle 날짜 문자열까지 보여 주는 도구"
  heading="에포크·시간 변환기"
  tagline="Unix 타임스탬프 ↔ 날짜를 UTC·KST로 바꾸고 로그 볼 때 바로 써요"
>
  <div class="tool-panel">
    <h2>숫자(에포크) → 시각</h2>
    <div class="ep-row">
      <label for="ep-in" class="visually-hidden">에포크 값</label>
      <input id="ep-in" class="tool-input tool-mono ep-grow" inputmode="numeric" autocomplete="off" placeholder="예) 1763366400" />
      <label for="ep-unit" class="visually-hidden">단위</label>
      <select id="ep-unit" class="tool-select">
        <option value="auto">자동</option>
        <option value="s">초</option>
        <option value="ms">밀리초</option>
      </select>
      <button id="ep-now" class="tool-btn" type="button">지금</button>
    </div>
    <div id="ep-out" class="ep-out" aria-live="polite"></div>
    <p id="ep-msg" class="tool-msg"></p>
  </div>

  <div class="tool-panel">
    <h2>시각 → 숫자(에포크)</h2>
    <div class="ep-row">
      <label for="dt-in" class="visually-hidden">날짜·시각</label>
      <input id="dt-in" class="tool-input tool-mono ep-grow" type="datetime-local" step="1" />
      <label for="dt-tz" class="visually-hidden">시간대</label>
      <select id="dt-tz" class="tool-select">
        <option value="local">내 시간대</option>
        <option value="kst">KST (UTC+9)</option>
        <option value="utc">UTC</option>
      </select>
      <button id="dt-now" class="tool-btn" type="button">지금</button>
    </div>
    <div id="dt-out" class="ep-out" aria-live="polite"></div>
    <p id="dt-msg" class="tool-msg"></p>
  </div>

  <div class="tool-panel">
    <h2>참고</h2>
    <ul class="ep-help">
      <li>에포크(Unix time)는 1970-01-01 00:00:00 UTC부터 흐른 시간이에요. 보통 <strong>초</strong>(10자리) 또는 <strong>밀리초</strong>(13자리)로 써요.</li>
      <li>'자동'은 자릿수로 초·밀리초를 가려내요(값이 크면 밀리초로 봐요).</li>
      <li>KST(한국 표준시)는 UTC보다 9시간 빨라요. 서머타임은 없어요.</li>
      <li>Oracle 줄은 <code class="tool-mono">YYYYMMDDHH24MISS</code> 문자열(KST)이라 <code class="tool-mono">TO_DATE</code>에 바로 써요.</li>
    </ul>
  </div>
</Base>

<script>
  const $ = (id: string) => document.getElementById(id)!;
  const epIn = $('ep-in') as HTMLInputElement;
  const epUnit = $('ep-unit') as HTMLSelectElement;
  const epOut = $('ep-out');
  const epMsg = $('ep-msg');
  const dtIn = $('dt-in') as HTMLInputElement;
  const dtTz = $('dt-tz') as HTMLSelectElement;
  const dtOut = $('dt-out');
  const dtMsg = $('dt-msg');

  const myTz = Intl.DateTimeFormat().resolvedOptions().timeZone || '내 시간대';
  const pad = (n: number) => String(n).padStart(2, '0');

  // 특정 시간대에서의 날짜 조각
  function partsIn(tz: string, ms: number) {
    const f = new Intl.DateTimeFormat('ko-KR', {
      timeZone: tz, year: 'numeric', month: '2-digit', day: '2-digit',
      hour: '2-digit', minute: '2-digit', second: '2-digit', hourCycle: 'h23', weekday: 'short',
    });
    const o: Record<string, string> = {};
    for (const p of f.formatToParts(new Date(ms))) o[p.type] = p.value;
    return o;
  }
  function fmtTz(tz: string, ms: number) {
    const o = partsIn(tz, ms);
    return `${o.year}-${o.month}-${o.day} (${o.weekday}) ${o.hour}:${o.minute}:${o.second}`;
  }
  function oracleStr(tz: string, ms: number) {
    const o = partsIn(tz, ms);
    return `${o.year}${o.month}${o.day}${o.hour}${o.minute}${o.second}`;
  }
  function relative(ms: number) {
    const diff = Math.round((ms - Date.now()) / 1000);
    const a = Math.abs(diff);
    const suffix = diff >= 0 ? '후' : '전';
    if (a < 60) return `${a}초 ${suffix}`;
    if (a < 3600) return `${Math.floor(a / 60)}분 ${suffix}`;
    if (a < 86400) return `${Math.floor(a / 3600)}시간 ${suffix}`;
    if (a < 86400 * 365) return `${Math.floor(a / 86400)}일 ${suffix}`;
    return `${Math.floor(a / (86400 * 365))}년 이상 ${suffix}`;
  }

  // 결과 행(라벨·값·복사) 그리기
  function renderRows(target: HTMLElement, rows: [string, string][]) {
    target.replaceChildren();
    for (const [label, value] of rows) {
      const row = document.createElement('div');
      row.className = 'ep-line';
      const k = document.createElement('span');
      k.className = 'ep-k';
      k.textContent = label;
      const v = document.createElement('code');
      v.className = 'ep-v tool-mono';
      v.textContent = value;
      const btn = document.createElement('button');
      btn.className = 'ep-copy';
      btn.type = 'button';
      btn.textContent = '복사';
      btn.setAttribute('aria-label', `${label} 복사`);
      btn.addEventListener('click', async () => {
        try {
          await navigator.clipboard.writeText(value);
          btn.textContent = '복사됨';
          setTimeout(() => (btn.textContent = '복사'), 1200);
        } catch {
          btn.textContent = '실패';
        }
      });
      row.append(k, v, btn);
      target.append(row);
    }
  }

  // ── 에포크 → 시각 ──
  function renderEpoch() {
    epMsg.textContent = '';
    epMsg.classList.remove('is-error');
    const raw = epIn.value.trim().replace(/[,_\s]/g, '');
    if (!raw) { epOut.replaceChildren(); return; }
    if (!/^-?\d+$/.test(raw)) {
      epOut.replaceChildren();
      epMsg.textContent = '숫자만 넣어 주세요.';
      epMsg.classList.add('is-error');
      return;
    }
    const n = Number(raw);
    let ms: number;
    if (epUnit.value === 'ms') ms = n;
    else if (epUnit.value === 's') ms = n * 1000;
    else ms = Math.abs(n) >= 1e11 ? n : n * 1000; // 자동
    if (!Number.isFinite(ms) || Math.abs(ms) > 8.64e15) {
      epOut.replaceChildren();
      epMsg.textContent = '다룰 수 있는 범위를 벗어났어요.';
      epMsg.classList.add('is-error');
      return;
    }
    renderRows(epOut, [
      ['UTC', fmtTz('UTC', ms)],
      ['KST', fmtTz('Asia/Seoul', ms)],
      [`내 시간대 (${myTz})`, fmtTz(myTz, ms)],
      ['Oracle (KST)', oracleStr('Asia/Seoul', ms)],
      ['ISO 8601', new Date(ms).toISOString()],
      ['상대', relative(ms)],
    ]);
  }

  // ── 시각 → 에포크 ──
  function renderDate() {
    dtMsg.textContent = '';
    dtMsg.classList.remove('is-error');
    const val = dtIn.value;
    if (!val) { dtOut.replaceChildren(); return; }
    let iso = val.length === 16 ? val + ':00' : val;
    let ms: number;
    if (dtTz.value === 'utc') ms = new Date(iso + 'Z').getTime();
    else if (dtTz.value === 'kst') ms = new Date(iso + '+09:00').getTime();
    else ms = new Date(iso).getTime();
    if (!Number.isFinite(ms)) {
      dtOut.replaceChildren();
      dtMsg.textContent = '시각을 읽지 못했어요.';
      dtMsg.classList.add('is-error');
      return;
    }
    renderRows(dtOut, [
      ['초 (s)', String(Math.floor(ms / 1000))],
      ['밀리초 (ms)', String(ms)],
      ['ISO 8601 (UTC)', new Date(ms).toISOString()],
    ]);
  }

  $('ep-now').addEventListener('click', () => {
    epUnit.value = 's';
    epIn.value = String(Math.floor(Date.now() / 1000));
    renderEpoch();
  });
  $('dt-now').addEventListener('click', () => {
    const d = new Date();
    dtTz.value = 'local';
    dtIn.value = `${d.getFullYear()}-${pad(d.getMonth() + 1)}-${pad(d.getDate())}T${pad(d.getHours())}:${pad(d.getMinutes())}:${pad(d.getSeconds())}`;
    renderDate();
  });

  epIn.addEventListener('input', renderEpoch);
  epUnit.addEventListener('change', renderEpoch);
  dtIn.addEventListener('input', renderDate);
  dtTz.addEventListener('change', renderDate);

  // 첫 화면: 지금 값으로 채워 바로 보여 주기
  const params = new URL(location.href).searchParams;
  if (params.get('t')) { epIn.value = params.get('t')!; epUnit.value = 'auto'; }
  else { epUnit.value = 's'; epIn.value = String(Math.floor(Date.now() / 1000)); }
  const now = new Date();
  dtIn.value = `${now.getFullYear()}-${pad(now.getMonth() + 1)}-${pad(now.getDate())}T${pad(now.getHours())}:${pad(now.getMinutes())}:${pad(now.getSeconds())}`;
  renderEpoch();
  renderDate();
</script>

<style>
  .ep-row { display: flex; flex-wrap: wrap; gap: 8px; align-items: center; }
  .ep-grow { flex: 1 1 220px; font-size: 1.15rem; padding: 10px 14px; }
  .tool-select {
    font: inherit; font-size: 0.95rem; padding: 9px 12px; border-radius: 10px;
    border: 1px solid var(--hairline); background: var(--surface-2); color: var(--ink); cursor: pointer;
  }
  .ep-out { margin-top: 14px; display: grid; gap: 8px; }
  .ep-out:empty { margin-top: 0; }
  /* 결과 행은 JS로 만들어지므로 :global 로 스타일을 건다 */
  .ep-out :global(.ep-line) {
    display: grid; grid-template-columns: minmax(7rem, auto) 1fr auto; gap: 14px; align-items: center;
    padding: 10px 14px; border: 1px solid var(--hairline); border-radius: 10px; background: var(--surface-1);
  }
  .ep-out :global(.ep-k) { font-size: 0.82rem; color: var(--text-muted); white-space: nowrap; }
  .ep-out :global(.ep-v) { background: none; border: 0; padding: 0; font-size: 1.05rem; font-weight: 600; color: var(--accent); word-break: break-all; }
  .ep-out :global(.ep-copy) {
    font: inherit; font-size: 0.8rem; cursor: pointer; padding: 5px 12px; border-radius: 8px;
    border: 1px solid var(--hairline); background: var(--surface-2); color: var(--text-muted);
  }
  .ep-out :global(.ep-copy:hover) { color: var(--accent); border-color: var(--accent); }
  .ep-help { margin: 0; padding-left: 1.2em; font-size: 0.9rem; line-height: 1.8; color: var(--text-muted); }
  .ep-help :global(code) { font-size: 0.86em; padding: 1px 5px; border-radius: 5px; background: var(--surface-2); }
  @media (max-width: 560px) {
    .ep-out :global(.ep-line) { grid-template-columns: 1fr auto; }
    .ep-out :global(.ep-k) { grid-column: 1 / -1; }
  }
</style>
