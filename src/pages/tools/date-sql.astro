---
import Base from '../../layouts/Base.astro';
---

<Base
  title="날짜 컬럼 조회 도우미"
  description="Oracle 날짜 조회에서 TO_CHAR·TO_DATE 중 뭘 쓸지, DATE·문자 컬럼별로 맞는 WHERE 조건과 표시 SELECT를 만들어 주는 도구"
  heading="날짜 컬럼 조회"
  tagline="DATE냐 문자(VARCHAR)냐에 맞춰 WHERE 조건과 TO_CHAR 표시를 만들어 줘요"
>
  <div class="tool-panel">
    <h2>설정</h2>

    <div class="ds-grid">
      <label for="ds-col">컬럼명</label>
      <input id="ds-col" class="tool-input tool-mono ds-col" value="REG_DT" autocomplete="off" spellcheck="false" />

      <span class="ds-label">컬럼 타입</span>
      <div class="ds-seg" role="group" aria-label="컬럼 타입">
        <button type="button" class="ds-seg-btn" data-type="date" aria-pressed="true">DATE 타입</button>
        <button type="button" class="ds-seg-btn" data-type="varchar" aria-pressed="false">문자(VARCHAR) 저장</button>
      </div>

      <label for="ds-fmt" id="ds-fmt-label" hidden>저장 형식</label>
      <select id="ds-fmt" class="tool-select" hidden>
        <option value="YYYYMMDD">YYYYMMDD (예: 20261117)</option>
        <option value="YYYYMMDDHH24MISS">YYYYMMDDHH24MISS (예: 20261117091500)</option>
        <option value="YYYY-MM-DD">YYYY-MM-DD (예: 2026-11-17)</option>
        <option value="YYYY-MM-DD HH24:MI:SS">YYYY-MM-DD HH24:MI:SS</option>
      </select>

      <span class="ds-label">조회 범위</span>
      <div class="ds-seg" role="group" aria-label="조회 범위">
        <button type="button" class="ds-seg-btn ds-range" data-range="day" aria-pressed="true">하루</button>
        <button type="button" class="ds-seg-btn ds-range" data-range="period" aria-pressed="false">기간</button>
      </div>

      <span class="ds-label" id="ds-d1-label">날짜</span>
      <div class="ds-dates">
        <input id="ds-d1" class="tool-input tool-mono ds-date" type="date" />
        <span class="ds-sep" id="ds-d2-wrap" hidden>
          <span class="ds-tilde" aria-hidden="true">~</span>
          <label for="ds-d2" class="visually-hidden">끝 날짜</label>
          <input id="ds-d2" class="tool-input tool-mono ds-date" type="date" />
        </span>
      </div>
    </div>
  </div>

  <div class="tool-panel">
    <h2>WHERE 조건</h2>
    <div class="ds-out">
      <pre id="ds-where" class="ds-sql tool-mono"></pre>
      <button id="ds-where-copy" class="tool-btn" type="button">복사</button>
    </div>
    <p id="ds-where-note" class="tool-hint"></p>
  </div>

  <div class="tool-panel">
    <h2>표시용 SELECT</h2>
    <div class="ds-out">
      <pre id="ds-select" class="ds-sql tool-mono"></pre>
      <button id="ds-select-copy" class="tool-btn" type="button">복사</button>
    </div>
    <p id="ds-select-note" class="tool-hint"></p>
  </div>

  <div class="tool-panel">
    <h2>TO_CHAR? TO_DATE? 헷갈릴 때</h2>
    <ul class="ds-help">
      <li><strong>TO_CHAR = 날짜 → 문자</strong>. DATE 컬럼을 보기 좋게 찍거나 문자로 비교할 때. <code class="tool-mono">TO_CHAR(col,'YYYY-MM-DD')</code></li>
      <li><strong>TO_DATE = 문자 → 날짜</strong>. 문자로 저장된 날짜를 날짜로 계산할 때. <code class="tool-mono">TO_DATE(col,'YYYYMMDD')</code></li>
      <li>기억법: <strong>결과가 문자면 TO_CHAR, 결과가 날짜면 TO_DATE</strong>. (TO_뒤 = 바꾼 뒤 타입)</li>
      <li>DATE 컬럼은 <code class="tool-mono">col &gt;= … AND col &lt; …</code> 반열린 범위가 <strong>인덱스를 타요</strong>. <code class="tool-mono">TO_CHAR(col)=…</code>나 <code class="tool-mono">TRUNC(col)=…</code>는 함수 기반 인덱스가 없으면 인덱스를 못 타요.</li>
      <li>문자로 저장된 날짜가 <code class="tool-mono">YYYYMMDD</code>처럼 정렬 가능한 형식이면, 굳이 TO_DATE 없이 <strong>문자 그대로 비교</strong>해도 돼요.</li>
    </ul>
  </div>
</Base>

<script>
  const $ = (id: string) => document.getElementById(id)!;
  const colEl = $('ds-col') as HTMLInputElement;
  const fmtLabel = $('ds-fmt-label');
  const fmtEl = $('ds-fmt') as HTMLSelectElement;
  const d1El = $('ds-d1') as HTMLInputElement;
  const d2El = $('ds-d2') as HTMLInputElement;
  const d2Wrap = $('ds-d2-wrap');
  const d1Label = $('ds-d1-label');
  const whereEl = $('ds-where');
  const whereNote = $('ds-where-note');
  const selectEl = $('ds-select');
  const selectNote = $('ds-select-note');

  let type: 'date' | 'varchar' = 'date';
  let range: 'day' | 'period' = 'day';

  const pad = (n: number) => String(n).padStart(2, '0');
  const col = () => (colEl.value.trim() || 'REG_DT');

  // 'YYYY-MM-DD' 입력값 → {y,m,d}
  function parse(v: string) {
    const [y, m, d] = v.split('-').map(Number);
    return { y, m, d };
  }
  const ymd = (p: { y: number; m: number; d: number }) => `${p.y}${pad(p.m)}${pad(p.d)}`;
  function nextDay(p: { y: number; m: number; d: number }) {
    const dt = new Date(p.y, p.m - 1, p.d + 1);
    return { y: dt.getFullYear(), m: dt.getMonth() + 1, d: dt.getDate() };
  }

  // 문자 저장 형식에 맞춘 하루의 시작/끝 문자열
  function storedStr(p: { y: number; m: number; d: number }, endOfDay: boolean) {
    const fmt = fmtEl.value;
    const date = `${p.y}${pad(p.m)}${pad(p.d)}`;
    const dateDash = `${p.y}-${pad(p.m)}-${pad(p.d)}`;
    const t6 = endOfDay ? '235959' : '000000';
    const tColon = endOfDay ? '23:59:59' : '00:00:00';
    switch (fmt) {
      case 'YYYYMMDD': return date;
      case 'YYYYMMDDHH24MISS': return date + t6;
      case 'YYYY-MM-DD': return dateDash;
      case 'YYYY-MM-DD HH24:MI:SS': return `${dateDash} ${tColon}`;
      default: return date;
    }
  }

  function buildWhere() {
    const c = col();
    const p1 = parse(d1El.value);
    const p2 = range === 'period' && d2El.value ? parse(d2El.value) : p1;
    if (!p1.y) return { sql: '-- 날짜를 선택하세요', note: '' };

    if (type === 'date') {
      const start = ymd(p1);
      const endExclusive = ymd(nextDay(p2)); // 끝 날짜의 다음날 00:00 미만
      return {
        sql:
          `${c} >= TO_DATE('${start}','YYYYMMDD')\n` +
          `AND ${c} <  TO_DATE('${endExclusive}','YYYYMMDD')`,
        note: '시·분·초까지 들어간 DATE라도 그날 전체가 잡히고, 인덱스를 타는 반열린 범위예요.',
      };
    }

    // varchar
    const s = storedStr(p1, false);
    const e = storedStr(p2, true);
    if (s === e) {
      return { sql: `${c} = '${s}'`, note: '정렬 가능한 문자 형식이라 문자 그대로 비교해요(인덱스 OK).' };
    }
    return {
      sql: `${c} >= '${s}'\nAND ${c} <= '${e}'`,
      note: '정렬 가능한 문자 형식이라 문자 범위로 비교해요(인덱스 OK). 날짜 연산이 필요하면 TO_DATE(' + c + ",'" + fmtEl.value + "') 을 쓰세요.",
    };
  }

  function buildSelect() {
    const c = col();
    if (type === 'date') {
      return {
        sql: `TO_CHAR(${c}, 'YYYY-MM-DD HH24:MI:SS') AS ${c}`,
        note: 'DATE 컬럼을 보기 좋은 문자로 찍어요(날짜 → 문자라서 TO_CHAR).',
      };
    }
    return {
      sql: `TO_CHAR(TO_DATE(${c}, '${fmtEl.value}'), 'YYYY-MM-DD HH24:MI:SS') AS ${c}`,
      note: '문자를 날짜로 읽어(TO_DATE) 다른 형식으로 다시 찍어요(TO_CHAR). 그대로 보려면 변환 없이 ' + c + ' 만 쓰면 돼요.',
    };
  }

  function render() {
    const w = buildWhere();
    whereEl.textContent = w.sql;
    whereNote.textContent = w.note;
    const s = buildSelect();
    selectEl.textContent = s.sql;
    selectNote.textContent = s.note;
  }

  // 세그먼트(타입/범위) 토글
  document.querySelectorAll<HTMLButtonElement>('.ds-seg-btn').forEach((b) => {
    b.addEventListener('click', () => {
      if (b.dataset.type) {
        type = b.dataset.type as 'date' | 'varchar';
        document.querySelectorAll<HTMLButtonElement>('[data-type]').forEach((x) =>
          x.setAttribute('aria-pressed', String(x === b)),
        );
        fmtLabel.hidden = type !== 'varchar';
        fmtEl.hidden = type !== 'varchar';
      } else if (b.dataset.range) {
        range = b.dataset.range as 'day' | 'period';
        document.querySelectorAll<HTMLButtonElement>('.ds-range').forEach((x) =>
          x.setAttribute('aria-pressed', String(x === b)),
        );
        d2Wrap.hidden = range !== 'period';
        d1Label.textContent = range === 'period' ? '시작 날짜' : '날짜';
      }
      render();
    });
  });

  colEl.addEventListener('input', render);
  fmtEl.addEventListener('change', render);
  d1El.addEventListener('input', render);
  d2El.addEventListener('input', render);

  function copyFrom(pre: HTMLElement, btn: HTMLElement) {
    btn.addEventListener('click', async () => {
      const text = pre.textContent ?? '';
      if (!text || text.startsWith('--')) return;
      try {
        await navigator.clipboard.writeText(text);
        btn.textContent = '복사됨';
        setTimeout(() => (btn.textContent = '복사'), 1200);
      } catch {
        btn.textContent = '실패';
      }
    });
  }
  copyFrom(whereEl, $('ds-where-copy'));
  copyFrom(selectEl, $('ds-select-copy'));

  // 오늘 날짜로 시작
  const now = new Date();
  const today = `${now.getFullYear()}-${pad(now.getMonth() + 1)}-${pad(now.getDate())}`;
  d1El.value = today;
  d2El.value = today;
  render();
</script>

<style>
  .ds-grid { display: grid; grid-template-columns: max-content 1fr; gap: 16px 20px; align-items: center; }
  .ds-grid > label, .ds-grid > .ds-label { margin: 0; font-size: 0.9rem; font-weight: 600; color: var(--text-muted); text-align: right; white-space: nowrap; }
  .ds-col { width: 100%; max-width: 300px; font-size: 1.1rem; padding: 9px 13px; }
  .tool-select { justify-self: start; font: inherit; font-size: 0.95rem; padding: 9px 12px; border-radius: 10px; border: 1px solid var(--hairline); background: var(--surface-2); color: var(--ink); cursor: pointer; }
  .ds-seg { justify-self: start; display: inline-flex; gap: 4px; padding: 4px; border: 1px solid var(--hairline); border-radius: 12px; background: var(--surface-2); flex-wrap: wrap; }
  .ds-seg-btn { font: inherit; font-size: 0.9rem; font-weight: 600; cursor: pointer; padding: 7px 16px; border: 0; border-radius: 9px; background: none; color: var(--text-muted); }
  .ds-seg-btn[aria-pressed='true'] { background: var(--surface-1); color: var(--accent); box-shadow: 0 1px 3px rgba(0,0,0,.08); }
  .ds-dates { display: flex; gap: 12px; flex-wrap: wrap; align-items: center; }
  .ds-sep { display: inline-flex; gap: 12px; align-items: center; }
  .ds-sep[hidden] { display: none; }
  .ds-tilde { color: var(--text-muted); }
  .ds-date { font-size: 1rem; padding: 8px 12px; }
  @media (max-width: 560px) {
    .ds-grid { grid-template-columns: 1fr; gap: 6px; }
    .ds-grid > label, .ds-grid > .ds-label { text-align: left; margin-top: 10px; }
    .ds-grid > label:first-child, .ds-grid > .ds-label:first-of-type { margin-top: 0; }
  }
  .ds-out { display: flex; gap: 10px; align-items: flex-start; }
  .ds-sql { flex: 1; margin: 0; padding: 14px 16px; border: 1px solid var(--hairline); border-radius: 10px; background: var(--surface-1); color: var(--ink); font-size: 1rem; line-height: 1.6; white-space: pre-wrap; word-break: break-word; }
  .ds-help { margin: 0; padding-left: 1.2em; font-size: 0.9rem; line-height: 1.9; color: var(--text-muted); }
  .ds-help :global(code) { font-size: 0.86em; padding: 1px 5px; border-radius: 5px; background: var(--surface-2); }
  .ds-help strong { color: var(--ink); }
</style>
