---
// AI 픽 2쪽부터: /picks/page/2/ ...
import { getCollection } from 'astro:content';
import Base from '../../../layouts/Base.astro';
import PickList from '../../../components/PickList.astro';
import { PICKS_PER_PAGE } from '../../../consts';

export async function getStaticPaths() {
  const all = (await getCollection('picks')).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
  const pages = Math.ceil(all.length / PICKS_PER_PAGE);
  return Array.from({ length: Math.max(0, pages - 1) }, (_, i) => {
    const page = i + 2;
    return { params: { page: String(page) }, props: { picks: all.slice((page - 1) * PICKS_PER_PAGE, page * PICKS_PER_PAGE), page, pages, total: all.length } };
  });
}
const { picks, page, pages, total } = Astro.props;
---

<Base title={`AI 픽 ${page}쪽`} description="모구가 골라 읽고 정리한 AI 도구·소식" heading="AI 픽" tagline="모구가 골라 읽고 한국어로 정리한 AI 도구와 소식">
  <PickList picks={picks} page={page} pages={pages} total={total} />
</Base>
