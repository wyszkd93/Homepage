---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import PickList from '../../components/PickList.astro';
import { PICKS_PER_PAGE } from '../../consts';

const all = (await getCollection('picks')).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const pages = Math.max(1, Math.ceil(all.length / PICKS_PER_PAGE));
---

<Base title="AI 픽" description="모구가 골라 읽고 정리한 AI 도구·소식" heading="AI 픽" tagline="모구가 골라 읽고 한국어로 정리한 AI 도구와 소식">
  <PickList picks={all.slice(0, PICKS_PER_PAGE)} page={1} pages={pages} total={all.length} />
</Base>
