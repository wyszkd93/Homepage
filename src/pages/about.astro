---
import Base from '../layouts/Base.astro';
import { PROFILE } from '../consts';
import { Image } from 'astro:assets';
import mogu from '../assets/mogu.webp';

// ✏️ 소개 페이지 문구는 여기서 수정합니다. (관심 분야·기술 스택·링크는 src/consts.ts의 PROFILE)
const blogNotes = ['직접 해 본 것만 적어요', '다시 찾기 쉽게 정리해요', '오픈소스 DB 이야기도 곧!'];
---

<Base title="소개" description="Oracle DBA 모구(mogu)를 소개합니다.">
  <link slot="head" rel="preconnect" href="https://fonts.googleapis.com" />
  <link slot="head" rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link slot="head" rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Gaegu:wght@400;700&display=swap" />

  <div class="me">
    <section class="hello">
      <Image
        class="hello-art"
        src={mogu}
        widths={[280, 420, 560]}
        sizes="(max-width: 720px) 200px, 280px"
        alt="안경과 나비넥타이를 한 포메라니안 캐릭터 모구가 노트북으로 코딩하는 그림"
        loading="eager"
      />
      <div class="bubble">
        <p class="bubble-hi">안녕하세요, 모구예요! 🐾</p>
        <p>
          Oracle을 중심으로 <strong>DB · EAI · 백업 솔루션</strong>을 돌보는 DBA예요. 구축부터 운영까지, 데이터가 멈추지 않게 지키는 일을 해요.
        </p>
        <p>
          여기는 제가 다시 찾아보려고 남기는 메모장이에요. 같은 문제를 만난 누군가에게 지름길이 되면 더 좋고요.
        </p>
      </div>
    </section>

    <section class="board" aria-labelledby="board-title">
      <h2 id="board-title" class="board-title">모구의 메모판</h2>
      <ul class="notes">
        <li class="note yellow">
          <h3>📌 요즘 관심</h3>
          <ul>{PROFILE.interests.map((i) => <li>{i}</li>)}</ul>
        </li>
        <li class="note mint">
          <h3>🧰 자주 쓰는 도구</h3>
          <p class="tags">{PROFILE.stack.map((s) => <span>{s}</span>)}</p>
        </li>
        <li class="note peach">
          <h3>✍️ 이 블로그는</h3>
          <ul>{blogNotes.map((n) => <li>{n}</li>)}</ul>
        </li>
        <li class="note sky">
          <h3>💌 놀러 오세요</h3>
          <ul>{PROFILE.links.map((l) => <li><a href={l.url}>{l.label}</a></li>)}</ul>
        </li>
      </ul>
    </section>

    <p class="sign">오늘도 데이터가 무사하길 바라며, 모구 🐶</p>
  </div>
</Base>

<style>
  .me {
    --hand: 'Gaegu', 'Pretendard Variable', Pretendard, system-ui, sans-serif;
    --note-ink: #3a322c;
    max-width: 960px;
    margin: 0 auto;
    padding: 40px 0 16px;
  }

  /* 인사: 모구 그림 + 말풍선 */
  .hello {
    display: grid;
    grid-template-columns: 280px 1fr;
    align-items: center;
    gap: 36px;
  }
  .hello-art {
    width: 280px;
    height: auto;
    border-radius: 28px;
  }
  .bubble {
    position: relative;
    background: var(--surface-1);
    border: 2px solid var(--accent-line);
    border-radius: 24px;
    padding: 26px 30px;
    line-height: 1.8;
    box-shadow: var(--shadow);
  }
  .bubble::before,
  .bubble::after {
    content: '';
    position: absolute;
    top: 50%;
    border-style: solid;
    transform: translateY(-50%);
  }
  .bubble::before {
    left: -20px;
    border-width: 12px 20px 12px 0;
    border-color: transparent var(--accent-line) transparent transparent;
  }
  .bubble::after {
    left: -16px;
    border-width: 10px 17px 10px 0;
    border-color: transparent var(--surface-1) transparent transparent;
  }
  .bubble p { margin: 0 0 10px; }
  .bubble p:last-child { margin-bottom: 0; }
  .bubble-hi {
    font-family: var(--hand);
    font-size: 2rem;
    font-weight: 700;
    line-height: 1.3;
    color: var(--accent);
  }

  /* 메모판 */
  .board {
    margin-top: 56px;
    padding: 28px 28px 36px;
    border-radius: 20px;
    background-color: var(--surface-2);
    background-image: radial-gradient(var(--hairline) 1.2px, transparent 1.2px);
    background-size: 18px 18px;
    border: 1px solid var(--hairline);
  }
  .board-title {
    font-family: var(--hand);
    font-size: 1.8rem;
    margin: 0 0 22px;
    text-align: center;
  }
  .notes {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 22px;
  }
  .note {
    position: relative;
    padding: 26px 18px 20px;
    color: var(--note-ink);
    border-radius: 4px 4px 14px 4px;
    box-shadow: 0 2px 4px rgb(60 40 20 / 10%), 0 10px 18px rgb(60 40 20 / 10%);
    transform: rotate(var(--tilt, 0deg));
    transition: transform 0.2s ease;
  }
  .note:hover { transform: rotate(0deg) translateY(-4px); }
  .note::before {
    /* 마스킹 테이프 */
    content: '';
    position: absolute;
    top: -10px;
    left: 50%;
    width: 64px;
    height: 20px;
    transform: translateX(-50%) rotate(-3deg);
    background: rgb(255 255 255 / 55%);
    border: 1px solid rgb(0 0 0 / 5%);
  }
  .note:nth-child(1) { --tilt: -2deg; }
  .note:nth-child(2) { --tilt: 1.5deg; }
  .note:nth-child(3) { --tilt: -1deg; }
  .note:nth-child(4) { --tilt: 2deg; }
  .note.yellow { background: #fff3b0; }
  .note.mint { background: #d9f2e3; }
  .note.peach { background: #ffdcc6; }
  .note.sky { background: #d8e9fb; }
  .note h3 {
    font-family: var(--hand);
    font-size: 1.35rem;
    margin: 0 0 10px;
  }
  .note ul {
    margin: 0;
    padding-left: 1.1em;
    line-height: 1.75;
    font-size: 0.93rem;
  }
  .note a { color: #8a3f15; font-weight: 600; }
  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 5px;
    margin: 0;
  }
  .tags span {
    font-size: 0.8rem;
    padding: 2px 8px;
    border-radius: 999px;
    background: rgb(255 255 255 / 60%);
  }

  .sign {
    font-family: var(--hand);
    font-size: 1.5rem;
    text-align: right;
    color: var(--text-muted);
    margin: 28px 8px 0;
  }

  :global(:root[data-theme='dark']) .note { filter: brightness(0.86) saturate(0.9); }

  @media (max-width: 860px) {
    .notes { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 640px) {
    .me { padding-top: 24px; }
    .hello { grid-template-columns: 1fr; justify-items: center; gap: 28px; }
    .hello-art { width: 200px; }
    .bubble { padding: 22px 20px; }
    .bubble::before,
    .bubble::after { top: auto; left: 50%; transform: translateX(-50%); }
    .bubble::before {
      top: -20px;
      border-width: 0 12px 20px 12px;
      border-color: transparent transparent var(--accent-line) transparent;
    }
    .bubble::after {
      top: -16px;
      border-width: 0 10px 17px 10px;
      border-color: transparent transparent var(--surface-1) transparent;
    }
    .bubble-hi { font-size: 1.7rem; }
    .board { padding: 24px 16px 28px; }
    .notes { grid-template-columns: 1fr; gap: 26px; }
    .sign { text-align: center; }
  }
</style>
