---
import Base from '../layouts/Base.astro';
import { PROFILE } from '../consts';
import { Image } from 'astro:assets';
import mogu from '../assets/mogu.webp';

// ✏️ 소개 페이지 문구는 여기서 수정합니다. (관심 분야·기술 스택·링크는 src/consts.ts의 PROFILE)
const blogNotes = ['직접 해 본 것만', '다시 찾기 쉽게', '오픈소스 DB도 곧'];
---

<Base title="소개" description="Oracle DBA 모구(mogu)를 소개합니다.">
  <link slot="head" rel="preconnect" href="https://fonts.googleapis.com" />
  <link slot="head" rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link slot="head" rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Gaegu:wght@400;700&display=swap" />

  <div class="me">
    <section class="hello">
      <Image
        class="hello-art"
        src={mogu}
        widths={[280, 420, 560]}
        sizes="(max-width: 720px) 200px, 280px"
        alt="안경과 나비넥타이를 한 포메라니안 캐릭터 모구가 노트북으로 코딩하는 그림"
        loading="eager"
      />
      <div class="bubble">
        <p class="bubble-hi">안녕하세요, 모구예요! 🐾</p>
        <p>
          Oracle을 중심으로 <strong>DB · EAI · 백업 솔루션</strong>을 돌보는 DBA예요. 구축부터 운영까지, 데이터가 멈추지 않게 지키는 일을 해요.
        </p>
        <p>
          여기는 제가 다시 찾아보려고 남기는 메모장이에요. 같은 문제를 만난 누군가에게 지름길이 되면 더 좋고요.
        </p>
      </div>
    </section>

    <section class="board" aria-labelledby="board-title">
      <h2 id="board-title" class="board-title">모구 한눈에 보기</h2>
      <ul class="notes">
        <li class="note" style="--c:#e0a100">
          <span class="note-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"/><circle cx="12" cy="12" r="5"/><circle cx="12" cy="12" r="1.2"/></svg></span>
          <p class="note-eyebrow">Interests</p>
          <h3>요즘 관심</h3>
          <ul>{PROFILE.interests.map((i) => <li>{i}</li>)}</ul>
        </li>
        <li class="note" style="--c:#2f9e6f">
          <span class="note-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><ellipse cx="12" cy="5.5" rx="7.5" ry="2.8"/><path d="M4.5 5.5v6.5c0 1.5 3.4 2.8 7.5 2.8s7.5-1.3 7.5-2.8V5.5"/><path d="M4.5 12v6.5c0 1.5 3.4 2.8 7.5 2.8s7.5-1.3 7.5-2.8V12"/></svg></span>
          <p class="note-eyebrow">Stack</p>
          <h3>자주 쓰는 도구</h3>
          <p class="tags">{PROFILE.stack.map((t) => <span>{t}</span>)}</p>
        </li>
        <li class="note" style="--c:#e0673a">
          <span class="note-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M4 20h4L19 9a2.8 2.8 0 0 0-4-4L4 16v4z"/><path d="M13.5 6.5l4 4"/></svg></span>
          <p class="note-eyebrow">Blog</p>
          <h3>이 블로그는</h3>
          <ul>{blogNotes.map((n) => <li>{n}</li>)}</ul>
        </li>
        <li class="note" style="--c:#3f7fe0">
          <span class="note-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><rect x="3" y="5" width="18" height="14" rx="2.5"/><path d="M3.5 7l8.5 6 8.5-6"/></svg></span>
          <p class="note-eyebrow">Contact</p>
          <h3>놀러 오세요</h3>
          <ul class="links">{PROFILE.links.map((l) => <li><a href={l.url}>{l.label}</a></li>)}</ul>
        </li>
      </ul>
    </section>

    <p class="sign">오늘도 데이터가 무사하길 바라며, 모구 🐶</p>
  </div>
</Base>

<style>
  .me {
    --hand: 'Gaegu', 'Pretendard Variable', Pretendard, system-ui, sans-serif;
    max-width: 1040px;
    margin: 0 auto;
    padding: 40px 0 16px;
  }

  /* 인사: 모구 그림 + 말풍선 */
  .hello {
    display: grid;
    grid-template-columns: 280px 1fr;
    align-items: center;
    gap: 36px;
  }
  .hello-art {
    width: 280px;
    height: auto;
    border-radius: 28px;
  }
  .bubble {
    position: relative;
    background: var(--surface-1);
    border: 2px solid var(--accent-line);
    border-radius: 24px;
    padding: 26px 30px;
    line-height: 1.8;
    box-shadow: var(--shadow);
  }
  .bubble::before,
  .bubble::after {
    content: '';
    position: absolute;
    top: 50%;
    border-style: solid;
    transform: translateY(-50%);
  }
  .bubble::before {
    left: -20px;
    border-width: 12px 20px 12px 0;
    border-color: transparent var(--accent-line) transparent transparent;
  }
  .bubble::after {
    left: -16px;
    border-width: 10px 17px 10px 0;
    border-color: transparent var(--surface-1) transparent transparent;
  }
  .bubble p { margin: 0 0 10px; }
  .bubble p:last-child { margin-bottom: 0; }
  .bubble-hi {
    font-family: var(--hand);
    font-size: 2rem;
    font-weight: 700;
    line-height: 1.3;
    color: var(--accent);
  }

  /* 한눈에 보기 */
  .board { margin-top: 72px; }
  .board-title {
    font-family: var(--hand);
    font-size: 1.9rem;
    margin: 0 0 26px;
    text-align: center;
  }
  .notes {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 16px;
  }
  .note {
    position: relative;
    padding: 24px 20px 20px;
    border-radius: 18px;
    background: var(--surface-1);
    border: 1px solid var(--hairline);
    transition: transform 0.2s ease, box-shadow 0.2s ease, border-color 0.2s ease;
  }
  .note:hover {
    transform: translateY(-3px);
    border-color: color-mix(in srgb, var(--c) 45%, var(--hairline));
    box-shadow: var(--shadow);
  }
  .note-icon {
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border-radius: 12px;
    background: color-mix(in srgb, var(--c) 14%, var(--surface-1));
    color: var(--c);
    margin-bottom: 16px;
  }
  .note-icon svg {
    width: 20px;
    height: 20px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.8;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .note-eyebrow {
    margin: 0 0 2px;
    font: 600 0.68rem/1.4 ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--c);
  }
  .note h3 {
    font-size: 1.02rem;
    font-weight: 700;
    letter-spacing: -0.01em;
    margin: 0 0 12px;
  }
  .note ul {
    list-style: none;
    margin: 0;
    padding: 0;
    counter-reset: n;
    font-size: 0.875rem;
    line-height: 1.5;
    word-break: keep-all;
  }
  .note ul li {
    counter-increment: n;
    display: flex;
    align-items: baseline;
    gap: 10px;
    padding: 9px 0;
    border-top: 1px solid var(--hairline);
    color: var(--ink);
  }
  .note ul li:last-child { padding-bottom: 0; }
  .note ul li::before {
    content: counter(n, decimal-leading-zero);
    flex: none;
    font: 600 0.7rem/1 ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
    color: var(--text-muted);
  }
  .note .links a {
    flex: 1;
    display: flex;
    justify-content: space-between;
    color: var(--ink);
    font-weight: 600;
  }
  .note .links a::after {
    content: '↗';
    color: var(--c);
    transition: transform 0.15s ease;
  }
  .note .links a:hover { text-decoration: none; color: var(--c); }
  .note .links a:hover::after { transform: translate(2px, -2px); }
  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin: 0;
    padding-top: 10px;
    border-top: 1px solid var(--hairline);
  }
  .tags span {
    font-size: 0.78rem;
    padding: 3px 9px;
    border-radius: 7px;
    color: var(--ink-muted);
    background: var(--surface-2);
  }

  .sign {
    font-family: var(--hand);
    font-size: 1.5rem;
    text-align: right;
    color: var(--text-muted);
    margin: 28px 8px 0;
  }

  @media (max-width: 900px) {
    .notes { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 640px) {
    .me { padding-top: 24px; }
    .hello { grid-template-columns: 1fr; justify-items: center; gap: 28px; }
    .hello-art { width: 200px; }
    .bubble { padding: 22px 20px; }
    .bubble::before,
    .bubble::after { top: auto; left: 50%; transform: translateX(-50%); }
    .bubble::before {
      top: -20px;
      border-width: 0 12px 20px 12px;
      border-color: transparent transparent var(--accent-line) transparent;
    }
    .bubble::after {
      top: -16px;
      border-width: 0 10px 17px 10px;
      border-color: transparent transparent var(--surface-1) transparent;
    }
    .bubble-hi { font-size: 1.7rem; }
    .notes { grid-template-columns: 1fr; gap: 14px; }
    .sign { text-align: center; }
  }
</style>
