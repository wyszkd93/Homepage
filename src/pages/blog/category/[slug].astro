---
import Base from '../../../layouts/Base.astro';
import BlogBrowser from '../../../components/BlogBrowser.astro';
import { CATEGORIES, type Category } from '../../../categories';
import { getPosts, type Post } from '../../../utils/posts';

export async function getStaticPaths() {
  const all = await getPosts();
  return CATEGORIES.map((category) => ({
    params: { slug: category.slug },
    props: { category, all, posts: all.filter((p) => p.category.slug === category.slug) },
  })).filter((p) => p.props.posts.length > 0);
}

interface Props {
  category: Category;
  all: Post[];
  posts: Post[];
}
const { category, all, posts } = Astro.props;
---

<Base title={category.name} description={category.description} heading={category.name} tagline={`${category.description} · 글 ${posts.length}개`}>
  <BlogBrowser all={all} posts={posts} active={category.slug} />
</Base>
