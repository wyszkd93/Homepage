---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import TagList from '../../components/TagList.astro';
import { getPosts, type Post } from '../../utils/posts';
import { url, formatDate } from '../../utils/url';

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post, i) => ({
    params: { slug: post.id },
    props: { post, newer: posts[i - 1], older: posts[i + 1] },
  }));
}

interface Props {
  post: Post;
  newer?: Post;
  older?: Post;
}

const { post, newer, older } = Astro.props;
const { Content } = await render(post);
const { title, description, date, updated, tags, source } = post.data;
---

<Base title={title} description={description} heading={title} narrow>
  <div class="post-head-meta" slot="hero">
    <time datetime={date.toISOString()}>{formatDate(date)}</time>
    {updated && <span>· 수정 {formatDate(updated)}</span>}
    <TagList tags={tags} />
  </div>

  <article class="prose">
    <Content />
  </article>

  {source && (
    <p class="source-note">
      이 글은 <a href={source}>Tistory</a>에서 옮겨 온 글입니다.
    </p>
  )}

  <nav class="post-nav" aria-label="이전/다음 글">
    {older ? (
      <a class="card" href={url(`/blog/${older.id}/`)}><span class="nav-label">← 이전 글</span>{older.data.title}</a>
    ) : <span></span>}
    {newer ? (
      <a class="card next" href={url(`/blog/${newer.id}/`)}><span class="nav-label">다음 글 →</span>{newer.data.title}</a>
    ) : <span></span>}
  </nav>
</Base>
