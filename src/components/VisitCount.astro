---
// GoatCounter 방문 수를 푸터에 보여 줘요: 오늘 N  누적 방문 N
// GoatCounter 설정에서 'Allow adding visitor counts on your website'가 켜져 있어야 숫자를 받아올 수 있어요.
// 누적 숫자를 받아오지 못하거나(설정 꺼짐·차단·오류) 아직 0이면 아무것도 보이지 않아요.
---

<span class="visit-count" data-visit hidden>
  <span data-part="today">오늘 <b data-v="today">0</b></span>
  <span>누적 방문 <b data-v="total">0</b></span>
</span>

<script>
  import { GOATCOUNTER } from '../consts';

  function get(start?: string): Promise<number | null> {
    const q = start ? `?start=${start}` : '';
    return fetch(`${GOATCOUNTER}/counter/TOTAL.json${q}`)
      .then((r) => (r.status === 404 ? { count: '0' } : r.ok ? r.json() : null))
      .then((j) => (j ? Number(String(j.count).replace(/[^\d]/g, '')) || 0 : null))
      .catch(() => null);
  }
  // 한국 시간 기준 오늘 날짜 (YYYY-MM-DD)
  const today = new Date(Date.now() + 9 * 3600e3).toISOString().slice(0, 10);
  const fmt = (n: number) => n.toLocaleString('ko-KR');
  const SINCE = '2026-10-01'; // 방문 기록 시작(2026-11) 이전

  async function fill(el: HTMLElement) {
    // start 없이 부르면 GoatCounter 서버 캐시에 남은 옛 값(0)이 와서, 기록 시작 전 날짜를 붙여 누적을 받음
    const [total, now] = await Promise.all([get(SINCE), get(today)]);
    if (total == null || total === 0) return;
    el.querySelector<HTMLElement>('[data-v="total"]')!.textContent = fmt(total);
    if (now == null) el.querySelector('[data-part="today"]')?.remove();
    else el.querySelector<HTMLElement>('[data-v="today"]')!.textContent = fmt(now);
    el.hidden = false;
  }
  if (!/^(localhost|127\.)/.test(location.hostname) || new URLSearchParams(location.search).has('visits')) {
    document.querySelectorAll<HTMLElement>('[data-visit]').forEach((el) => void fill(el));
  }
</script>

<style>
  .visit-count[hidden] { display: none; }
  .visit-count { color: var(--text-muted); font-size: 0.72rem; display: inline-flex; gap: 12px; }
  .visit-count b { font-weight: 700; color: inherit; font-variant-numeric: tabular-nums; }
</style>
