---
import type { Category } from '../categories';
import { url } from '../utils/url';

interface Props {
  category: Category;
  link?: boolean;
}
const { category, link = true } = Astro.props;
const Tag = link ? 'a' : 'span';
---

<Tag class="cat" style={`--cat: ${category.color}`} href={link ? url(`/blog/category/${category.slug}/`) : undefined}>
  {category.name}
</Tag>
