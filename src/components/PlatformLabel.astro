---
import type { Platform, Topic } from '../categories';
import { categoryUrl } from '../utils/posts';
import { url } from '../utils/url';
import TopicLabel from './TopicLabel.astro';

interface Props {
  platform: Platform;
  /** 주면 "Oracle › [주제]"처럼 함께 표시 */
  topic?: Topic;
}
const { platform, topic } = Astro.props;
---

<span class="cat-path">
  <a class="plat" style={`--cat: ${platform.color}`} href={url(categoryUrl(platform))}>{platform.name}</a>
  {topic && <><span class="cat-sep" aria-hidden="true">›</span><TopicLabel platform={platform} topic={topic} link /></>}
</span>
