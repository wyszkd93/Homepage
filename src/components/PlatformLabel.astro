---
import type { Platform, Topic } from '../categories';
import { categoryUrl } from '../utils/posts';
import { url } from '../utils/url';

interface Props {
  platform: Platform;
  /** 주면 "Oracle › 성능·튜닝"처럼 함께 표시 */
  topic?: Topic;
  link?: boolean;
}
const { platform, topic, link = true } = Astro.props;
---

{link ? (
  <span class="cat-path">
    <a class="cat" style={`--cat: ${platform.color}`} href={url(categoryUrl(platform))}>{platform.name}</a>
    {topic && <><span class="cat-sep" aria-hidden="true">›</span><a class="cat-topic" href={url(categoryUrl(platform, topic))}>{topic.name}</a></>}
  </span>
) : (
  <span class="cat" style={`--cat: ${platform.color}`}>{platform.name}</span>
)}
