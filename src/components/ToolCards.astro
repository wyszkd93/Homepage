---
import { toolHref, isNew, type Tool } from '../data/tools';
import { url } from '../utils/url';

interface Props {
  items: Tool[];
}
const { items } = Astro.props;
---

<ul class="tool-cards">
  {items.map((t) => (
    <li>
      <a class="tool-card" href={url(toolHref(t))} style={`--tool: ${t.color}`} data-slug={t.slug}>
        <span class="tool-card-top">
          <span class="tool-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" set:html={t.icon} />
          </span>
          {t.badge ? <span class={`tool-badge tool-badge-${t.badge.toLowerCase()}`}>{t.badge}</span> : <span class="tool-badge tool-badge-new" data-added={t.added} hidden={!isNew(t)}>NEW</span>}
        </span>
        <span class="tool-title">{t.title}</span>
        <span class="tool-desc">{t.description}</span>
        <span class="tool-go">{t.kind === 'game' ? '플레이 →' : '써 보기 →'}</span>
      </a>
    </li>
  ))}
</ul>

<script>
  import { NEW_DAYS } from '../data/tools';
  // NEW는 올린 날(한국 시간 자정 기준)부터 NEW_DAYS일 동안만. 빌드 시점이 아니라 보는 순간의 날짜로 판단해요.
  const now = Date.now();
  for (const b of document.querySelectorAll<HTMLElement>('[data-added]')) {
    const start = new Date(`${b.dataset.added}T00:00:00+09:00`).getTime();
    b.hidden = !(now >= start && now < start + NEW_DAYS * 864e5);
  }
</script>
