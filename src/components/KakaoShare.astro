---
// 카카오톡 공유 버튼. KAKAO_JS_KEY가 비어 있으면 아무것도 그리지 않습니다.
// 페이지에서 window에 'share:update' 이벤트({ text })를 보내면 공유 문구가 바뀝니다.
import { KAKAO_JS_KEY } from '../consts';

interface Props {
  title: string;
  description: string;
  label?: string;
}
const { title, description, label = '카카오톡으로 공유하기' } = Astro.props;
---

{KAKAO_JS_KEY && (
  <div class="kk-wrap">
    <button class="kk-btn" type="button" data-title={title} data-desc={description}>
      <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path fill="currentColor" d="M12 3C6.48 3 2 6.58 2 11c0 2.85 1.86 5.35 4.66 6.77-.2.74-.74 2.7-.85 3.12-.13.52.19.51.4.37.17-.11 2.62-1.78 3.68-2.5.69.1 1.39.15 2.11.15 5.52 0 10-3.58 10-8S17.52 3 12 3z"/></svg>
      {label}
    </button>
  </div>
)}

<script>
  import { shareKakao } from '../lib/kakao';

  for (const btn of document.querySelectorAll<HTMLButtonElement>('.kk-btn')) {
    window.addEventListener('share:update', (e) => {
      const text = (e as CustomEvent<{ text: string }>).detail?.text;
      if (text) btn.dataset.desc = text;
    });
    btn.addEventListener('click', () => {
      shareKakao({ title: btn.dataset.title ?? document.title, description: btn.dataset.desc ?? '' }).catch((err) => {
        console.error(err);
        alert('카카오톡 공유를 열지 못했어요. 잠시 후 다시 시도해 주세요.');
      });
    });
  }
</script>

<style>
  .kk-wrap { display: flex; justify-content: center; margin: 20px 0 8px; }
  .kk-btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 10px 18px;
    border: 0;
    border-radius: 12px;
    background: #fee500;
    color: #191919;
    font: inherit;
    font-weight: 700;
    font-size: 0.92rem;
    cursor: pointer;
  }
  .kk-btn:hover { filter: brightness(0.97); }
</style>
