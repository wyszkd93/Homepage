---
import { PLATFORMS, topicsOf, type Platform, type Topic } from '../categories';
import { categoryUrl, type Post } from '../utils/posts';
import { url } from '../utils/url';
import PostRows from './PostRows.astro';

interface Props {
  all: Post[];
  posts: Post[];
  platform?: Platform;
  topic?: Topic;
}
const { all, posts, platform, topic } = Astro.props;

// 글이 있는 분야·주제만
const tree = PLATFORMS.map((p) => {
  const inP = all.filter((x) => x.platform.slug === p.slug);
  const topics = topicsOf(p)
    .map((t) => ({ topic: t, count: inP.filter((x) => x.topic.slug === t.slug).length }))
    .filter((t) => t.count > 0);
  return { platform: p, count: inP.length, topics };
}).filter((p) => p.count > 0);
const activeTree = tree.find((t) => t.platform.slug === platform?.slug);
---

<div class="blog-layout">
  <nav class="cat-nav" aria-label="분류">
    <p class="cat-nav-title">분류</p>
    <ul class="cat-tree">
      <li>
        <a href={url('/blog/')} aria-current={!platform ? 'page' : undefined}>
          <span>전체</span><span class="count">{all.length}</span>
        </a>
      </li>
      {tree.map((p) => (
        <li class="cat-platform" style={`--cat: ${p.platform.color}`}>
          <!-- 화살표를 누르면 주제 목록을 접고 펼침. 지금 보고 있는 분야는 펼친 상태로 시작 -->
          <details open={p.platform.slug === platform?.slug}>
            <summary>
              <span class="chev" aria-hidden="true">
                <svg viewBox="0 0 24 24" width="12" height="12"><path d="m9 6 6 6-6 6" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/></svg>
              </span>
              <a href={url(categoryUrl(p.platform))} aria-current={p.platform.slug === platform?.slug && !topic ? 'page' : undefined}>
                <span><i class="dot" aria-hidden="true"></i>{p.platform.name}</span><span class="count">{p.count}</span>
              </a>
            </summary>
          <ul class="cat-topics">
            {p.topics.map((t) => (
              <li>
                <a
                  href={url(categoryUrl(p.platform, t.topic))}
                  aria-current={p.platform.slug === platform?.slug && t.topic.slug === topic?.slug ? 'page' : undefined}
                >
                  <span><i class="dot" style={`--cat: ${t.topic.color}`} aria-hidden="true"></i>{t.topic.name}</span><span class="count">{t.count}</span>
                </a>
              </li>
            ))}
          </ul>
          </details>
        </li>
      ))}
    </ul>
    {activeTree && (
      <ul class="cat-topics-mobile" aria-label={`${activeTree.platform.name} 주제`}>
        <li><a href={url(categoryUrl(activeTree.platform))} aria-current={!topic ? 'page' : undefined}>전체 {activeTree.count}</a></li>
        {activeTree.topics.map((t) => (
          <li>
            <a href={url(categoryUrl(activeTree.platform, t.topic))} aria-current={t.topic.slug === topic?.slug ? 'page' : undefined}>
              {t.topic.name} {t.count}
            </a>
          </li>
        ))}
      </ul>
    )}
  </nav>
  <div class="blog-main">
    <PostRows posts={posts} byYear showPlatform={!platform} showTopic={!topic} />
  </div>
</div>
